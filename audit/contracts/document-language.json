    "shared_body_fallback": {
      "path": "cargo/shared-early-init.html",
      "setter": "document.documentElement.setAttribute('lang', 'en');",
      "setter_precedes": "if (window.__mmsEarlyPreviewStarted) return;"
    },
    "standalone_root_attribute": "lang=\"en\"",
    "write_descendant_override": {
      "language": "yue-Hant",
      "expected_count": 1,
      "sources": [
        "cargo/write.template.html",
        "cargo/write.html",
        "cargo/write-test.html"
      ]
    }
  },
  "browser_contract": {
    "viewports": {
      "compact": {
        "width": 390,
        "height": 844
      },
      "expanded": {
        "width": 1440,
        "height": 900
      }
    },
    "axe_rules": [
      "html-has-lang",
      "html-lang-valid",
      "html-xml-lang-mismatch"
    ],
    "expected_root_language": "en",
    "expected_axe_violations": 0,
    "body_only_fallback": {
      "remove_standalone_root_attribute": true,
      "rerun_shared_initializer_after_one_shot_guard": true,
      "expected_root_language": "en"
    }
  },
  "negative_controls": [
