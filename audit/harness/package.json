{
  "name": "mms-audit-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MM.S audit harness using frozen Round 80 evidence and the latest responsive-70 gold parity target",
  "scripts": {
    "audit": "node src/cli.mjs",
    "gold-parity-test": "node src/gold-parity-test.mjs",
    "list": "node src/cli.mjs --list",
    "media-owner-test": "node src/media-playback-owner-test.mjs",
    "validate": "node src/cli.mjs --validate-config",
    "schema-test": "node src/schema-self-test.mjs",
    "self-test": "npm run schema-test && node src/self-test.mjs",
    "runtime-root-test": "node src/runtime-root-replacement-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.10.3",
    "playwright-core": "1.61.1"
  }
}
