{
  "name": "mms-audit-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MM.S audit harness using frozen Round 80 evidence and the latest responsive-70 gold parity target",
  "scripts": {
    "audit": "node src/cli.mjs",
    "document-language-test": "node src/document-language-test.mjs",
    "deferred-hydration-test": "node src/deferred-media-hydration-test.mjs",
    "embed-message-protocol-test": "node src/embed-message-protocol-test.mjs",
    "embed-montran-test": "node src/embed-montran-interaction-test.mjs",
    "eviive-pair-test": "node src/eviive-final-pair-geometry-test.mjs",
    "gold-parity-test": "node src/gold-parity-test.mjs",
    "iframe-capability-test": "node src/iframe-capability-test.mjs",
    "interaction-test": "npm run panel-scrubber-test && npm run startup-state-test && npm run embed-montran-test && npm run embed-message-protocol-test",
    "list": "node src/cli.mjs --list",
    "media-owner-test": "node src/media-playback-owner-test.mjs",
    "montran-pdf-allowlist-test": "node src/montran-pdf-allowlist-test.mjs",
    "panel-scrubber-test": "node src/panel-scrubber-transition-test.mjs",
    "portfolio-media-accessibility-test": "node src/portfolio-media-accessibility-test.mjs",
    "primary-navigation-test": "node src/primary-navigation-landmark-test.mjs",
    "reduced-motion-test": "node src/reduced-motion-path-test.mjs",
    "validate": "node src/cli.mjs --validate-config",
    "schema-test": "node src/schema-self-test.mjs",
    "self-test": "npm run schema-test && node src/self-test.mjs",
    "runtime-root-test": "node src/runtime-root-replacement-test.mjs",
    "river-aria-test": "node src/river-aria-source-test.mjs",
    "startup-state-test": "node src/startup-state-interaction-test.mjs",
    "swatch-focus-test": "node src/swatch-focus-test.mjs",
    "touchbaes-readiness-test": "node src/touchbaes-readiness-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.10.3",
    "playwright-core": "1.61.1"
  }
}
