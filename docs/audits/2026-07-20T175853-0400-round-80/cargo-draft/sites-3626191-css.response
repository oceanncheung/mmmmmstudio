{"id":1452539,"stylesheet":"html {\n\t--mobile-scale: 1.4;\n\t--mobile-padding-offset: 0.66;\n}\n\nbody {\n\t--swatch-1: rgba(0, 0, 0, 0.85);\n\t--swatch-2: rgba(0, 0, 0, 0.75);\n\t--swatch-3: rgba(0, 0, 0, 0.6);\n\t--swatch-4: rgba(0, 0, 0, 0.4);\n\t--swatch-5: rgba(0, 0, 0, 0.25);\n}\n\nbody.mobile {\n}\n\na:active,\n.linked:active,\n.zoomable::part(media):active {\n\topacity: 0.7;\n}\n\n.page a.active {\n}\n\nsub {\n\tposition: relative;\n\tvertical-align: baseline;\n\ttop: 0.3em;\n}\n\nsup {\n\tposition: relative;\n\tvertical-align: baseline;\n\ttop: -0.4em;\n}\n\n.small-caps {\n\tfont-variant: small-caps;\n    text-transform: lowercase;\n    letter-spacing: 0.03em;\n}\n\nol {\n\tmargin: 0;\n\tpadding: 0 0 0 2.5em;\n}\n\nul {\n\tmargin: 0;\n\tpadding: 0 0 0 2.0em;\n}\n\nul.lineated {\n\tmargin: 0;\n\tpadding: 0;\n\tlist-style-type: none;\n\tmargin: 0 0 0 3em;\n\ttext-indent: -3em;\n}\n\nblockquote {\n\tmargin: 0;\n\tpadding: 0 0 0 2em;\n}\n\nhr {\n\tbackground: rgba(0, 0, 0, 0.7);\n\tborder: 0;\n\theight: 1px;\n\tdisplay: block;\n    margin-top: 1.4rem;\n    margin-bottom: 0.25rem;\n}\n\n.content {\n}\n\nbodycopy {\n\tfont-size: 1.2rem;\n\tfont-weight: normal;\n\tcolor: rgba(0, 0, 0, 0.85);\n\tfont-family: serif;\n\tfont-style: normal;\n\tline-height: 1.25;\n\tletter-spacing: 0;\n\tdisplay: block;\n}\n\nbodycopy a {\n\tcolor: rgba(0, 0, 0, 0.85);\n\tborder-bottom: 0px solid rgba(127, 127, 127, 0.2);\n\ttext-decoration: none;\n}\n\nbodycopy a:hover {\n}\n\nh1 {\n    font-size: 3.5rem;\n\tfont-weight: 700;\n\tcolor: rgba(0, 0, 0, 0.8);\n\tfont-family: \"Diatype Variable\";\n\tfont-style: normal;\n\tline-height: 0.795;\n\tletter-spacing: 0;\n\tmargin: 0;\n\tfont-variation-settings: 'slnt' 0, 'MONO' 0;\n}\n\nh1 a {\n    color: rgba(0, 0, 0, 0.8);\n\tborder-bottom: 0px solid rgba(127, 127, 127, 0.2);\n\ttext-decoration: none;\n}\n\nh1 a:hover {\n}\n\nh2 {\n\tfont-style: normal;\n\tfont-weight: 350;\n\tcolor: rgba(0, 0, 0, 0.8);\n\tfont-family: \"Marist Variable\";\n\tfont-size: 2.4rem;\n\tline-height: 1.2;\n\tletter-spacing: 0em;\n\tpadding: 0;\n\tmargin: 0;\n}\n\nh2 a {\n\tcolor: rgba(0, 0, 0, 0.8);\n\ttext-decoration: none;\n}\n\nh2 a:hover {\n}\n\n.caption {\n\tfont-size: 0.833rem;\n\tfont-weight: 400;\n\tcolor: rgba(0, 0, 0, 0.75);\n\tfont-family: \"Diatype Variable\";\n\tfont-style: normal;\n\tline-height: 1.2;\n\tletter-spacing: -0.009em;\n\tdisplay: block;\n\tfont-variation-settings: 'slnt' 0, 'MONO' 0;\n}\n\n.caption a {\n\tcolor: rgba(0, 0, 0, 0.75);\n\ttext-decoration: none;\n}\n\n.caption a:hover {\n}\n\nmedia-item .caption {\n\tmargin-top: 0.6rem;\n}\n\ngallery-grid .caption,\ngallery-columnized .caption,\ngallery-justify .caption {\n\tmargin-bottom: 2em;\n}\n\n[thumbnail-index] .caption {\n\ttext-align: center;\n}\n\n[thumbnail-index] .caption .tags {\n\tmargin-top: 0.25em;\n}\n\n.page {\n\tjustify-content: flex-end;\n}\n\n.page-content {\n\tpadding: 1.5rem;\n\ttext-align: left;\n}\n\n.mobile [id] .page-layout {\n\tmax-width: 100%;\n}\n\n.page-layout {\n\talign-items: flex-start;\n\tmax-width: 64%;\n\tpadding: 0.0rem;\n}\n\nmedia-item::part(media) {\n\tborder: 0;\n\tpadding: 0;\n}\n\n.quick-view {\n\theight: 100%;\n\twidth: 100%;\n\tpadding: 1.5rem;\n\tmargin-top: 0;\n\tmargin-right: 0;\n\tmargin-bottom: auto;\n\tmargin-left: auto;\n}\n\n.quick-view-background {\n\tbackground-color: #ffffff;\n}\n\n.quick-view .caption {\n\tcolor: rgba(255, 255, 255, 1.0);\n\tpadding: 20px 0;\n\ttext-align: right;\n\ttransition: 100ms opacity ease-in-out;\n\tposition: absolute;\n\tbottom: 0;\n\tleft: 0;\n\tright: 0;\n}\n\n.quick-view .caption-background {\n\tpadding: 0.5rem 1rem;\n\tdisplay: inline-block;\n\tbackground: rgba(0, 0, 0, 0.5);\n\tborder-radius: .5rem;\n\ttext-align: left;\n\tmax-width: 50rem;\n}\n\n.mobile .quick-view {\n\twidth: 100%;\n\theight: 100%;\n\tmargin: 0;\n\tpadding: 10px;\n}\n\n.mobile .quick-view .caption {\n\tpadding: 10px 0;\n}\n\n.mobile .quick-view .caption-background {\n\tmax-width: 100vw;\n}\n\n::part(slideshow-nav) {\n\t--button-size: 30px;\n\t--button-inset: 20px;\n\t--button-icon-color: rgba(255, 255, 255, 0.9);\n\t--button-icon-stroke-width: 1.5px;\n\t--button-icon-stroke-linecap: none;\n\t--button-background-color: rgba(87, 87, 87, 0.35);\n\t--button-background-radius: 50%;\n\t--button-active-opacity: 0.7;\n}\n\ngallery-slideshow::part(slideshow-nav) {\n\t--button-inset: 15px;\n}\n\n.quick-view::part(slideshow-nav) {\n}\n\n.wallpaper-slideshow::part(slideshow-nav) {\n}\n\n.mobile ::part(slideshow-nav) {\n\t--button-inset: 10px;\n}\n\n.mobile .quick-view::part(slideshow-nav) {\n\t--button-inset: 25px;\n}\n\nshop-product {\n\tfont-size: 1.2rem;\n\tmax-width: 22rem;\n\tfont-family: \"Diatype Variable\";\n\tfont-style: normal;\n\tfont-weight: 400;\n\tfont-variation-settings: 'slnt' 0, 'MONO' 0;\n\tletter-spacing: 0em;\n\tmargin-bottom: 1em;\n}\n\nshop-product::part(price) {\n\tcolor: rgba(0, 0, 0, 0.75);\n\tline-height: 1.1;\n\tmargin-bottom: 0.5em;\n}\n\nshop-product::part(dropdown) {\n\twidth: 100%;\n\tcolor: rgba(0, 0, 0, 0.85);\n\tborder: 1px solid rgba(0, 0, 0, 0.2);\n\tbackground-color: rgba(255, 255, 255, 0.0);\n\tbackground-image: url(https:\/\/static.cargo.site\/assets\/images\/select-line-arrows.svg);\n\tbackground-repeat: no-repeat;\n\tbackground-position: top 0em right .1em;\n\tline-height: 1.2;\n\tpadding: 0.58em 2em 0.55em 0.9em;\n\tborder-radius: 10em;\n\tmargin-bottom: 0.5em;\n}\n\nshop-product::part(button) {\n\tbackground: rgba(0, 0, 0, 0.15);\n\tcolor: rgba(0, 0, 0, 0.75);\n\ttext-align: left;\n\tline-height: normal;\n\tpadding: 0.5em 1em;\n\tcursor: pointer;\n\tborder-radius: 10em;\n}\n\nshop-product::part(button):active {\n\topacity: .7;\n}\n\naudio-player {\n\t--text-color: rgba(0, 0, 0, 0.85);\n\t--text-padding: 0 1.2em 0 1.0em;\n\t--background-color: rgba(255, 255, 255, 0);\n\t--buffer-background-color: rgba(0, 0, 0, 0.03);\n\t--progress-background-color: rgba(0, 0, 0, 0.075);\n\t--border-lines: 1px solid rgba(0, 0, 0, 0.2);\n\tfont-size: 1.2rem;\n\twidth: 32rem;\n\theight: 2.75em;\n\tfont-family: \"Diatype Variable\";\n\tfont-style: normal;\n\tfont-weight: 400;\n\tfont-variation-settings: 'slnt' 0, 'MONO' 0;\n\tline-height: normal;\n\tletter-spacing: 0em;\n\tmargin-bottom: 0.5em;\n\tborder-radius: 10em;\n}\n\naudio-player::part(button) {\n\t--icon-color: rgba(0, 0, 0, 0.85);\n\t--icon-size: 32%;\n\t--play-text: '';\n\t--pause-text: '';\n\twidth: 3.15em;\n\tdisplay: inline-flex;\n\tjustify-content: center;\n\tcursor: pointer;\n}\n\naudio-player::part(play-icon) {\n\tpadding-left: 0.6em;\n}\n\naudio-player::part(pause-icon) {\n\tpadding-left: 0.4em;\n}\n\naudio-player::part(progress-indicator) {\n\tborder-right: 1px solid rgba(0, 0, 0, 0);\n\theight: 100%;\n\tcursor: ew-resize;\n}\n\naudio-player::part(separator) {\n\tborder-right: var(--border-lines);\n}\n\nbody.mobile audio-player {\n\tmax-width: 100%;\n}\n\n\/* mm.s \u2014 design tokens, generated from Figma variables 2026-07-06\n   Source of truth: Figma file aaJEv2Z8j6HaegMHou4N09 (all values exported mechanically).\n   Axes: data-theme (5) x data-face (4) x data-scale (4) x data-shape (3) on <html>. *\/\n\n\/* ---------- primitives ---------- *\/\n\/* palette v2 \"Final\" (Figma Draft_MMS_Portfolio 36:241, synced 2026-07-10):\n   girly = pink\/green, quirky = brown\/sky, contrast = yellow\/magenta.\n   navy + red primitives RETIRED with the navy theme. *\/\n:root {\n  --primitive-white: #FFFFFF; --primitive-black: #000000; --primitive-gray-60: #999999;\n  --primitive-pink: #FFEEF4; --primitive-brown: #553D12; --primitive-green: #00CD0A;\n  --primitive-sky: #4DBAFF; --primitive-yellow: #FEFF01; --primitive-magenta: #FF00FF;\n  --primitive-blue-link: #0000EE; --primitive-purple-visited: #551A8B;\n}\n\n\/* ---------- color themes (bg + ink pairs; link\/border follow ink) ---------- *\/\n:root, [data-theme=\"white\"] {\n  --color-bg-page: var(--primitive-white);\n  --color-text-primary: var(--primitive-black);\n  --color-text-muted: var(--primitive-gray-60);\n}\n[data-theme=\"black\"] {\n  --color-bg-page: var(--primitive-black);\n  --color-text-primary: var(--primitive-white);\n  --color-text-muted: var(--primitive-gray-60);\n}\n[data-theme=\"girly\"] {\n  --color-bg-page: var(--primitive-pink);\n  --color-text-primary: var(--primitive-green);\n  --color-text-muted: var(--primitive-green);\n}\n[data-theme=\"quirky\"] {\n  --color-bg-page: var(--primitive-brown);\n  --color-text-primary: var(--primitive-sky);\n  --color-text-muted: var(--primitive-sky);\n}\n[data-theme=\"contrast\"] {\n  --color-bg-page: var(--primitive-yellow);\n  --color-text-primary: var(--primitive-magenta);\n  --color-text-muted: var(--primitive-magenta);\n}\n:root {\n  --color-link: var(--color-text-primary);\n  --color-link-visited: var(--color-text-primary);\n  --color-border: var(--color-text-primary);\n}\n\n\/* ---------- fluid GRID + media units (1440px base) \u2014 TYPE IS NOT SCALED ----------\n   Ocean's rule (2026-07-06): \"the grid should be on scale. the font size\n   should always stay the same.\" So the compositional GRID scales as one\n   piece from the 1440 base, but every FONT SIZE stays a fixed px.\n     --layout-u = the expanded content-grid unit. It scales continuously from\n                  the 1024px structural hand-off through a 2560px cap.\n     --chrome-u = the navigation\/control unit. It stops at 1800px so the rail,\n                  panel and outer edge do not become oversized on wide screens.\n     --media-u  = the independent image\/video unit. It follows the grid on\n                  expanded screens and uses a smaller compact clamp.\n   Font sizes + line heights below are FIXED px. *\/\n:root {\n  --layout-u: clamp(0.711111px, calc(100vw \/ 1440), 1.777778px);\n  --chrome-u: clamp(0.711111px, calc(100vw \/ 1440), 1.25px);\n  --media-u: var(--layout-u);\n  --edge-pad: calc(40 * var(--chrome-u));\n  --page-pad: var(--edge-pad);\n  --u: var(--layout-u); \/* compatibility during the bodycopy asset migration *\/\n}\n\n\/* ---------- space \/ grid (continuous expanded layout) ---------- *\/\n:root {\n  --space-4: calc(4 * var(--layout-u)); --space-6: calc(6 * var(--layout-u)); --space-8: calc(8 * var(--layout-u));\n  --space-12: calc(12 * var(--layout-u)); --space-16: calc(16 * var(--layout-u)); --space-24: calc(24 * var(--layout-u));\n  --space-32: calc(32 * var(--layout-u)); --space-40: calc(40 * var(--layout-u)); --space-64: calc(64 * var(--layout-u));\n  --space-80: calc(80 * var(--layout-u));\n  --space-128: calc(128 * var(--layout-u)); --space-192: calc(192 * var(--layout-u)); --space-256: calc(256 * var(--layout-u));\n  --margin-page: var(--edge-pad); --measure-content: calc(548 * var(--layout-u));\n  --col-1: calc(84 * var(--layout-u)); --col-2: calc(200 * var(--layout-u)); --col-4: calc(432 * var(--layout-u)); --col-6: calc(664 * var(--layout-u));\n  --col-8: calc(896 * var(--layout-u)); --col-10: calc(1128 * var(--layout-u));\n  --radius-image: calc(24 * var(--layout-u));\n  --chrome-space-8: calc(8 * var(--chrome-u));\n  --chrome-space-16: calc(16 * var(--chrome-u));\n  --chrome-space-24: calc(24 * var(--chrome-u));\n  --chrome-space-32: calc(32 * var(--chrome-u));\n  --panel-control-u: clamp(1px, var(--chrome-u), 1.25px);\n  --panel-pad-block-expanded: var(--chrome-space-24);\n  --panel-pad-inline-expanded: var(--chrome-space-16);\n  --panel-width: calc(200 * var(--chrome-u));\n  --nav-col: calc(var(--edge-pad) + var(--panel-width) + var(--chrome-space-32)); \/* 272 @ 1440; 340 cap *\/\n}\n@media (max-width: 1023px) {\n  :root {\n    --layout-u: 1px;\n    --chrome-u: 1px;\n    --media-u: clamp(0.46px, calc(100vw \/ 760), 0.68px);\n    --edge-pad: clamp(16px, 5.128vw, 40px);\n    --page-pad: var(--edge-pad);\n    --margin-page: var(--edge-pad);\n    --measure-content: calc(100vw - (2 * var(--page-pad)));\n    \/* Compact reference grid: 6 stretch columns, 16px gutters. Figma shows\n       the 390px endpoint; Cargo resolves every intermediate viewport. *\/\n    --compact-grid-gutter: 16px;\n    --compact-grid-col: max(0px, calc((var(--measure-content) - (5 * var(--compact-grid-gutter))) \/ 6));\n    --compact-grid-span-2: calc((2 * var(--compact-grid-col)) + var(--compact-grid-gutter));\n    --compact-grid-span-4: calc((4 * var(--compact-grid-col)) + (3 * var(--compact-grid-gutter)));\n    --compact-grid-span-6: var(--measure-content);\n    --col-1: 45px; --col-2: 106px; --col-4: 228px;\n    --col-6: var(--measure-content); --col-8: var(--measure-content); --col-10: var(--measure-content);\n  }\n}\n\n\/* ---------- type scale: per-face sizes x per-scale \u2014 FIXED px (never scales with viewport) ---------- *\/\n\/* 2026-07-10 TYPE SCALE V2 (Ocean: \"let's do 22\"; plan docs\/plans\/2026-07-10-\n   type-scale-v2.md): serif ladder S18 M22 L27 XL36; roles caption = base x0.82,\n   heading = base x1.875; lh = x1.146 body \/ x1.143 caption \/ x1.222 heading,\n   whole px. Faces keep optical multipliers (sans x0.966, mono x0.90, gothic\n   x0.92). Figma Type Scale variables carry THE SAME numbers (synced this date).\n   The data-scale axis (s\/m\/l\/xl) is the USER's type-size slider \u2014 it swaps\n   these fixed sets; it is NOT the viewport. Type stays fixed as the grid\n   scales (Ocean, 2026-07-06). Caption leading is exposed per face so Gothic\n   can use a tighter optical rhythm without changing body or heading leading. *\/\n:root, [data-scale=\"m\"] {\n  --sz-caption-serif: 18px; --sz-caption-sans: 17.4px; --sz-caption-mono: 16.2px; --sz-caption-gothic: 16.6px;\n  --sz-base-serif: 22px;    --sz-base-sans: 21.3px;    --sz-base-mono: 19.8px;    --sz-base-gothic: 20.2px;\n  --sz-heading-serif: 41px; --sz-heading-sans: 39.6px; --sz-heading-mono: 36.9px; --sz-heading-gothic: 37.7px;\n  --lh-caption-serif: 21px; --lh-caption-sans: 21px; --lh-caption-mono: 21px; --lh-caption-gothic: 18px;\n  --lh-base: 25px; --lh-heading: 50px;\n}\n[data-scale=\"s\"] {\n  --sz-caption-serif: 15px; --sz-caption-sans: 14.5px; --sz-caption-mono: 13.5px; --sz-caption-gothic: 13.8px;\n  --sz-base-serif: 18px;    --sz-base-sans: 17.4px;    --sz-base-mono: 16.2px;    --sz-base-gothic: 16.6px;\n  --sz-heading-serif: 34px; --sz-heading-sans: 32.8px; --sz-heading-mono: 30.6px; --sz-heading-gothic: 31.3px;\n  --lh-caption-serif: 17px; --lh-caption-sans: 17px; --lh-caption-mono: 17px; --lh-caption-gothic: 15px;\n  --lh-base: 21px; --lh-heading: 41px;\n}\n[data-scale=\"l\"] {\n  --sz-caption-serif: 22px; --sz-caption-sans: 21.3px; --sz-caption-mono: 19.8px; --sz-caption-gothic: 20.2px;\n  --sz-base-serif: 27px;    --sz-base-sans: 26.1px;    --sz-base-mono: 24.3px;    --sz-base-gothic: 24.8px;\n  --sz-heading-serif: 51px; --sz-heading-sans: 49.3px; --sz-heading-mono: 45.9px; --sz-heading-gothic: 46.9px;\n  --lh-caption-serif: 25px; --lh-caption-sans: 25px; --lh-caption-mono: 25px; --lh-caption-gothic: 22px;\n  --lh-base: 31px; --lh-heading: 62px;\n}\n[data-scale=\"xl\"] {\n  --sz-caption-serif: 30px; --sz-caption-sans: 29px;   --sz-caption-mono: 27px;   --sz-caption-gothic: 27.6px;\n  --sz-base-serif: 36px;    --sz-base-sans: 34.8px;    --sz-base-mono: 32.4px;    --sz-base-gothic: 33.1px;\n  --sz-heading-serif: 68px; --sz-heading-sans: 65.7px; --sz-heading-mono: 61.2px; --sz-heading-gothic: 62.6px;\n  --lh-caption-serif: 34px; --lh-caption-sans: 34px; --lh-caption-mono: 34px; --lh-caption-gothic: 30px;\n  --lh-base: 41px; --lh-heading: 83px;\n}\n\n\/* 2026-07-13 DEVICE TYPE SCALE: compact screens use a dedicated ladder.\n   The user-facing S\/M\/L\/XL axis is preserved, but narrow screens no longer\n   inherit the more expansive desktop sizes. Fresh compact visits start at\n   Mobile Medium; panel.js owns that default while persisted choices survive. *\/\n@media (max-width: 1023px) {\n  :root, [data-scale=\"m\"] {\n    --sz-caption-serif: 17px; --sz-caption-sans: 16.4px; --sz-caption-mono: 15.3px; --sz-caption-gothic: 15.6px;\n    --sz-base-serif: 20px;    --sz-base-sans: 19.3px;    --sz-base-mono: 18px;      --sz-base-gothic: 18.4px;\n    --sz-heading-serif: 38px; --sz-heading-sans: 36.7px; --sz-heading-mono: 34.2px; --sz-heading-gothic: 35px;\n    --lh-caption-serif: 18px; --lh-caption-sans: 18px; --lh-caption-mono: 18px; --lh-caption-gothic: 17px;\n    --lh-base: 23px; --lh-heading: 46px;\n  }\n  [data-scale=\"s\"] {\n    --sz-caption-serif: 16px; --sz-caption-sans: 15.5px; --sz-caption-mono: 14.4px; --sz-caption-gothic: 14.7px;\n    --sz-base-serif: 17px;    --sz-base-sans: 16.4px;    --sz-base-mono: 15.3px;    --sz-base-gothic: 15.6px;\n    --sz-heading-serif: 32px; --sz-heading-sans: 30.9px; --sz-heading-mono: 28.8px; --sz-heading-gothic: 29.4px;\n    --lh-caption-serif: 17px; --lh-caption-sans: 17px; --lh-caption-mono: 17px; --lh-caption-gothic: 16px;\n    --lh-base: 20px; --lh-heading: 39px;\n  }\n  [data-scale=\"l\"] {\n    --sz-caption-serif: 20px; --sz-caption-sans: 19.3px; --sz-caption-mono: 18px;   --sz-caption-gothic: 18.4px;\n    --sz-base-serif: 24px;    --sz-base-sans: 23.2px;    --sz-base-mono: 21.6px; --sz-base-gothic: 22.1px;\n    --sz-heading-serif: 45px; --sz-heading-sans: 43.5px; --sz-heading-mono: 40.5px; --sz-heading-gothic: 41.4px;\n    --lh-caption-serif: 21px; --lh-caption-sans: 21px; --lh-caption-mono: 21px; --lh-caption-gothic: 20px;\n    --lh-base: 28px; --lh-heading: 55px;\n  }\n  [data-scale=\"xl\"] {\n    --sz-caption-serif: 25px; --sz-caption-sans: 24.2px; --sz-caption-mono: 22.5px; --sz-caption-gothic: 23px;\n    --sz-base-serif: 30px;    --sz-base-sans: 29px;      --sz-base-mono: 27px;   --sz-base-gothic: 27.6px;\n    --sz-heading-serif: 56px; --sz-heading-sans: 54.1px; --sz-heading-mono: 50.4px; --sz-heading-gothic: 51.5px;\n    --lh-caption-serif: 27px; --lh-caption-sans: 27px; --lh-caption-mono: 27px; --lh-caption-gothic: 25px;\n    --lh-base: 35px; --lh-heading: 68px;\n  }\n}\n\n\/* ---------- typeface axis: family + which size column to read ---------- *\/\n\/* Cargo font names may differ from these first candidates \u2014 adjust in Cargo's\n   editor after checking their picker (see DEPLOY.md). *\/\n:root, [data-face=\"serif\"] {\n  --font-family-base: \"Times New Roman\", Times, serif;\n  --font-size-caption: var(--sz-caption-serif);\n  --font-size-base: var(--sz-base-serif);\n  --font-size-heading: var(--sz-heading-serif);\n  --lh-caption: var(--lh-caption-serif);\n}\n[data-face=\"sans\"] {\n  --font-family-base: \"TeX Gyre Heros Condensed\", \"TeX Gyre Heros Cn\", \"Helvetica Neue Condensed\", \"Arial Narrow\", sans-serif;\n  --font-size-caption: var(--sz-caption-sans);\n  --font-size-base: var(--sz-base-sans);\n  --font-size-heading: var(--sz-heading-sans);\n  --lh-caption: var(--lh-caption-sans);\n}\n[data-face=\"mono\"] {\n  --font-family-base: \"Gaisyr Semi-Mono\", \"ABC Gaisyr Semi Mono\", \"ABC Gaisyr Semi Mono Trial\", \"Courier New\", monospace;\n  --font-size-caption: var(--sz-caption-mono);\n  --font-size-base: var(--sz-base-mono);\n  --font-size-heading: var(--sz-heading-mono);\n  --lh-caption: var(--lh-caption-mono);\n}\n[data-face=\"gothic\"] {\n  --font-family-base: \"UnifrakturMaguntia\", \"Times New Roman\", serif;\n  --font-size-caption: var(--sz-caption-gothic);\n  --font-size-base: var(--sz-base-gothic);\n  --font-size-heading: var(--sz-heading-gothic);\n  --lh-caption: var(--lh-caption-gothic);\n}\n\n\/* Cargo can append a page-local clone of an earlier token sheet after the\n   current site CSS. Bind the Gothic caption leading on the document element\n   so the current face-specific value wins that equal-specificity clone. *\/\nhtml[data-face=\"gothic\"] {\n  --lh-caption: var(--lh-caption-gothic);\n}\n\n\/* Cargo-managed text styles. Preserve these generated class blocks; edit them only through Cargo Text Styles. *\/\n.mms-mono {\n\t--text-style: \"mms mono\";\n\tfont-size: 1.2rem;\n\tfont-weight: 400;\n\tcolor: rgba(0, 0, 0, 0.85);\n\tfont-family: \"Gaisyr Semi-Mono\";\n\tfont-style: normal;\n\tline-height: 1.25;\n\tletter-spacing: 0;\n\tdisplay: block;\n}\n\n.mms-mono a {\n\tcolor: rgba(0, 0, 0, 0.85);\n\tborder-bottom: 0px solid rgba(127, 127, 127, 0.2);\n\ttext-decoration: none;\n}\n\n.mms-mono a:hover {\n\t\n}\n\n.mms-sans {\n\t--text-style: \"mms sans\";\n\tfont-size: 1.2rem;\n\tfont-weight: 400;\n\tcolor: rgba(0, 0, 0, 0.85);\n\tfont-family: \"TeX Gyre Heros Condensed\";\n\tfont-style: normal;\n\tline-height: 1.25;\n\tletter-spacing: 0;\n\tdisplay: block;\n}\n\n.mms-sans a {\n\tcolor: rgba(0, 0, 0, 0.85);\n\tborder-bottom: 0px solid rgba(127, 127, 127, 0.2);\n\ttext-decoration: none;\n}\n\n.mms-sans a:hover {\n\t\n}\n\n.mms-gothic {\n\t--text-style: \"mms gothic\";\n\tfont-size: 1.2rem;\n\tfont-weight: 400;\n\tcolor: rgba(0, 0, 0, 0.85);\n\tfont-family: UnifrakturMaguntia;\n\tfont-style: normal;\n\tline-height: 1.25;\n\tletter-spacing: 0;\n\tdisplay: block;\n}\n\n.mms-gothic a {\n\tcolor: rgba(0, 0, 0, 0.85);\n\tborder-bottom: 0px solid rgba(127, 127, 127, 0.2);\n\ttext-decoration: none;\n}\n\n.mms-gothic a:hover {\n\t\n}\n\n\/* mm.s \u2014 layout v3 (pairs with tokens.css). 2026-07-06 round 2 (mobile)\n   STICKY architecture, Cargo-proof: Cargo's .page wrappers create a containing\n   block and the editor scrolls an inner div, so position:fixed silently\n   detaches. Everything pinned is position:sticky \u2014 identical behavior in the\n   editor, preview, and published page.\n   DESKTOP: 2-col grid; left rail (nav top, control panel bottom) sticks to\n   the viewport; intro + clock stick in a 0-height layer bands scroll over.\n   COMPACT (<1024): sticky top bar (wordmark + menu + clock, z10); intro block\n   in flow with fill bg (slides UNDER the bar, z1); bands with fill bg slide\n   OVER the bar (z20); control panel = bottom sheet via html[data-panel] (z30). *\/\n\n\/* ---- page root + Cargo template neutralization \u2014 SCOPED to mms pages ----\n   panel.js sets data-theme on <html> on load, so these fire only on pages\n   that run the mms markup; every other page keeps the template untouched. *\/\nhtml[data-theme], html[data-theme] body {\n  margin: 0; padding: 0; min-height: 100%;\n  background: transparent !important;\n  overscroll-behavior-y: auto;\n}\n\/* Give ordinary iOS Safari a real theme-colored document canvas behind the\n   transparent Cargo\/page stack. Without it, WebKit blends its top material\n   against the UA's white fallback canvas, producing the pale gradient\/status\n   strip visible on dark and color themes. This is a backing surface, not an\n   edge plate: wrappers, sticky navigation, and media remain above it and keep\n   painting through to the physical screen edge. *\/\nhtml[data-mms-site][data-mms-ios-safari],\nhtml[data-mms-site][data-mms-ios-safari] body {\n  background-color: var(--color-bg-page) !important;\n  background-image: none !important;\n}\n\/* The MM.S composition, not a fixed root-color layer, owns the visible page.\n   This lets Safari's translucent status and URL material see the real river\n   media as it passes underneath. Cargo's wrappers must not insert an opaque\n   plate between that content and the physical viewport. *\/\nhtml[data-mms-site] .page,\nhtml[data-mms-site] .page-layout,\nhtml[data-mms-site] .page-content,\nhtml[data-mms-site] bodycopy {\n  background: transparent !important;\n}\n\n\/* iOS Safari startup edge sampler. Each 375ms cut receives a fresh TOP fixed\n   node so WebKit can extend that cut's color into its obscured status material\n   without caching the permanent sticky header. The real page or open panel\n   owns the lower edge, avoiding a visible physical-edge seam. It sits below the\n   complete .mms composition (root z1); the header (z10), showcase bands\n   (z20), and panel (z40) therefore paint above them. The samplers accept no\n   input and are removed completely before the transparent\/content-through\n   landing. *\/\n.mms-preview-edge-sampler {\n  position: fixed;\n  inset-inline: 0;\n  display: block;\n  pointer-events: none;\n  opacity: 1;\n  z-index: 0;\n  border: 0;\n}\n.mms-preview-edge-sampler[data-mms-preview-edge=\"top\"] {\n  top: 0;\n  \/* A 32px fallback intersected the upper half of the compact wordmark and\n     clock whenever WebKit reported a zero safe-area inset. Safari composites\n     this edge candidate outside normal DOM paint order, so z-index alone\n     could not prevent the apparent cover. Keep a one-pixel edge sample in\n     zero-inset contexts while still honoring a real device safe area. *\/\n  height: max(1px, env(safe-area-inset-top));\n}\nhtml[data-theme] .page-layout { max-width: none !important; }\nhtml[data-theme] .page-content { padding: 0 !important; }\nhtml[data-theme] bodycopy { max-width: none !important; }\nhtml[data-theme] .page.pinned { display: none !important; }\n\n\/* ---------- reset the parts we own ---------- *\/\n.mms, .mms * { margin: 0; padding: 0; box-sizing: border-box; }\n.mms {\n  position: relative; z-index: 1;\n  display: grid;\n  grid-template-columns: var(--nav-col) minmax(0, 1fr);\n  grid-template-rows: 1fr auto;\n  width: 100%;\n  margin-inline: 0;\n  min-height: 100vh;\n  min-height: 100dvh;\n  min-height: 100lvh;\n  background: var(--color-bg-page);\n  color: var(--color-text-primary);\n  font-family: var(--font-family-base);\n  font-size: var(--font-size-base);\n  line-height: var(--lh-base);\n}\n.mms em, .mms i { font-style: italic; }\n[data-face=\"gothic\"] .mms em, [data-face=\"gothic\"] .mms i { font-style: normal; }\n[data-face=\"gothic\"] .mms b, [data-face=\"gothic\"] .mms strong { font-weight: 400; } \/* single-cut *\/\n.mms a { color: var(--color-link); text-decoration: underline; line-height: var(--lh-base); }\n.mms a:visited { color: var(--color-link-visited); }\n\n\/* type roles *\/\n.mms h1, .mms h2 { font-size: var(--font-size-heading); line-height: var(--lh-heading); font-weight: bold; }\n.mms .body-bold, .mms b, .mms strong { font-weight: bold; }\n.mms .caption, .mms figcaption, .mms small { font-size: var(--font-size-caption); line-height: var(--lh-caption); }\n.mms .muted { color: var(--color-text-muted); }\n\n\/* mobile-only elements: hidden on desktop *\/\n.mms-mbar, .mms-mlinks, .mms-panel-head { display: none; }\n\n\/* ---------- desktop left rail (nav links; panel sits in grid row 2) ---------- *\/\n.mms-rail {\n  grid-column: 1; grid-row: 1;\n  display: flex; flex-direction: column;\n  padding: var(--edge-pad) var(--chrome-space-32) var(--edge-pad) var(--edge-pad);\n  background: var(--color-bg-page);\n  z-index: 30;\n}\n.mms-rail .rail-top { position: sticky; top: var(--edge-pad); z-index: 30; }\n.mms .wordmark { font-weight: bold; }\n.mms a.wordmark,\n.mms a.wordmark:visited {\n  display: inline-block;\n  color: inherit;\n  text-decoration: none;\n}\n.mms-rail ul { list-style: none; margin-top: var(--chrome-space-24); }\n.mms-rail a { display: inline-block; line-height: var(--lh-base); }\n\n\/* control panel: grid row 2 of the rail column, pinned to viewport bottom *\/\n.mms-panel {\n  grid-column: 1; grid-row: 2; align-self: end;\n  position: sticky; bottom: var(--edge-pad);\n  width: var(--panel-width);\n  max-width: none;\n  margin: 0 var(--chrome-space-32) var(--edge-pad) var(--edge-pad);\n  background: var(--color-bg-page);\n  color: var(--color-text-primary);\n  border: 1px solid var(--color-border);\n  padding: var(--chrome-space-16);\n  display: flex; flex-direction: column; gap: var(--chrome-space-16);\n  z-index: 30;\n}\ndialog.mms-panel:not([open]) { display: none; }\n\n\/* ---------- main column ---------- *\/\n\/* no right padding: rivers bleed to the viewport edge; elements that need\n   the right margin (clock, river scroll-end) carry it themselves *\/\n.mms-main {\n  grid-column: 2; grid-row: 1 \/ span 2; position: relative; min-width: 0;\n  padding: var(--edge-pad) 0 var(--edge-pad) 0;\n}\n\/* intro-wrap: groups the intro + first band. display:contents on desktop so\n   the desktop layout (sticky-head + spacer + bands as main's children) is\n   unchanged. On mobile it becomes the containing block that pins the intro\n   and RELEASES it once the first work has scrolled past (see mobile block). *\/\n.mms-intro-wrap { display: contents; }\n\/* intro + clock: 0-height sticky layer; bands slide over it (desktop) *\/\n.mms-sticky-head { position: sticky; top: var(--edge-pad); height: 0; z-index: 0; }\n.mms-intro { width: var(--col-6); }\n.mms-intro p { margin-top: var(--lh-base); }\n.mms-intro text-icon[icon=\"happy-face-1\"] {\n  width: 1em !important;\n  height: 1em !important;\n  margin: 0 0 -0.12em 0 !important;\n  vertical-align: baseline !important;\n}\n.mms-clock {\n  position: absolute; top: 0; right: var(--edge-pad);\n  color: var(--color-text-primary);\n  font-variant-numeric: tabular-nums;\n}\n.mms-intro-spacer { height: calc(280 * var(--layout-u)); } \/* transparent window over the sticky intro *\/\n\n\/* ---------- showcase bands (desktop: transparent, z10 over the intro) ---------- *\/\n.mms-band { position: relative; z-index: 10; background: transparent; }\n.mms-band {\n  content-visibility: auto;\n  contain-intrinsic-size: auto calc(650 * var(--layout-u));\n}\n\/* band-to-band gap. The second selector covers the first band being wrapped\n   in .mms-intro-wrap (mobile sticky intro) \u2014 band 2 then follows the wrap,\n   not another band, so plain `.mms-band + .mms-band` would miss it. *\/\n.mms-band + .mms-band,\n.mms-intro-wrap + .mms-band { margin-top: var(--space-192); }\n.mms-river {\n  display: flex; align-items: flex-end; gap: var(--space-32);\n  overflow-x: auto; overflow-y: hidden;\n  overscroll-behavior-x: auto;\n  scroll-behavior: auto;\n  scroll-snap-type: none;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n  height: calc(504 * var(--layout-u));\n  \/* full-bleed scroller: images run in from the viewport edge, but at max\n     scroll the LAST image rests at the content margin (clock-aligned) *\/\n  padding-right: var(--edge-pad);\n}\n.mms-river::-webkit-scrollbar { display: none; }\n.mms-river > * {\n  flex: 0 0 auto;\n  scroll-snap-align: none;\n  scroll-snap-stop: normal;\n}\n\/* Every river asset carries its Figma design dimensions as unitless custom\n   properties. Layout and media can now scale independently. *\/\n.mms-river > [style*=\"--asset-w\"] {\n  --asset-u: var(--media-u);\n  width: calc(var(--asset-w) * var(--asset-u));\n  height: calc(var(--asset-h) * var(--asset-u));\n  aspect-ratio: var(--asset-w) \/ var(--asset-h);\n}\n\/* spacer eats the flex gap that follows it, so image 1 lands exactly on\n   --offset \u2014 flush with the description block below *\/\n.mms-river .offset { width: calc(var(--offset, 0px) - var(--space-32)); height: 1px; }\n.mms-band[data-offset=\"4\"] { --offset: calc(var(--col-4) + var(--space-32)); }\n.mms-band[data-offset=\"2\"] { --offset: calc(var(--col-2) + var(--space-32)); }\n\n\/* description: static below the river, offset-aligned, own plate *\/\n.mms-desc {\n  width: var(--col-6);\n  margin-left: var(--offset, 0px);\n  background: var(--color-bg-page);\n  padding-top: var(--space-16);\n}\n\/* DESC COLUMN SPANS (Figma 12-col grid: col 84 \/ gutter 32 at design scale,\n   col 124 at XL \u2014 Round 15b, Ocean: \"understand how many columns they are\n   occupying\"). Every desc is an explicit span, never offset-derived:\n   V7\/Loop\/DeadGood = 10 cols; everything else = col-6 default.\n   (EVIIVE\/Kelly = 6 cols = the .mms-desc default, offset col-4.) *\/\n[data-band=\"eviive\"] .mms-desc, [data-band=\"v7\"] .mms-desc,\n[data-band=\"loop\"] .mms-desc, [data-band=\"kelly\"] .mms-desc,\n[data-band=\"deadgood\"] .mms-desc {\n  width: calc(100vw - var(--nav-col) - var(--offset, 0px) - var(--edge-pad));\n}\n\/* caption plates (Figma: fill bound to bg\/page on exactly these three) *\/\n[data-slot=\"montran-map-caption\"], [data-slot=\"kelly-caption\"],\n[data-slot=\"randompics-caption\"] { background: var(--color-bg-page); }\n.mms-desc .tagline { font-size: var(--font-size-caption); line-height: var(--lh-caption); }\n.mms-desc p { margin-top: var(--space-8); }\n.mms-desc .url { margin-top: var(--space-8); display: inline-block; }\n\n\/* ---------- desktop river scrubber ----------\n   Figma Slider 782:465: bg\/page plate, 16-unit block padding around a 1px\n   track, and an 8px square thumb. JS copies the associated description's\n   exact width\/left edge and maps the thumb to native river scrollLeft. *\/\n.mms-river-scrubber {\n  display: none;\n  position: relative;\n  box-sizing: border-box;\n  height: calc((2 * var(--space-16)) + 1px);\n  background: var(--color-bg-page);\n  color: var(--color-text-primary);\n  cursor: pointer;\n  user-select: none;\n  -webkit-user-select: none;\n}\n.mms-river-scrubber[hidden] { display: none !important; }\n.mms-river-scrubber__track {\n  position: absolute;\n  inset: 50% 0 auto;\n  height: 1px;\n  transform: translateY(-50%);\n  background: var(--color-border);\n  pointer-events: none;\n}\n.mms-river-scrubber__thumb {\n  position: absolute;\n  left: 0;\n  top: 50%;\n  height: max(44px, 100%);\n  width: max(var(--col-1), var(--scrub-proportional-width, 0px));\n  transform: translate(var(--scrub-thumb-left, 0px), -50%);\n  cursor: grab;\n  touch-action: none;\n}\n.mms-river-scrubber__thumb-art {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: calc(50% + 0.5px);\n  height: 8px;\n  box-sizing: border-box;\n  transform: translateY(-50%);\n  border: 1px solid var(--color-border);\n  background: var(--color-bg-page);\n  transition: none;\n  pointer-events: none;\n}\n.mms-river-scrubber.is-dragging .mms-river-scrubber__thumb { cursor: grabbing; }\n.mms-river-scrubber:focus,\n.mms-river-scrubber:focus-visible {\n  outline: none !important;\n  outline-offset: 0 !important;\n}\n.mms-river-scrubber:focus-visible .mms-river-scrubber__thumb-art {\n  outline: 0;\n  outline-offset: 0;\n  box-shadow: none;\n  height: 10px;\n  border: 2px solid var(--color-text-primary);\n  background: var(--color-bg-page);\n}\n.mms-river-scrubber.is-dragging .mms-river-scrubber__thumb-art,\n.mms-river-scrubber.is-dragging:focus-visible .mms-river-scrubber__thumb-art {\n  border-color: var(--color-text-primary);\n  background: var(--color-text-primary);\n}\n@media (min-width: 1024px) and (any-hover: hover) and (any-pointer: fine) {\n  .mms-river-scrubber:not([hidden]) { display: block; }\n  .mms-river-scrubber__thumb:hover .mms-river-scrubber__thumb-art {\n    border-color: var(--color-text-primary);\n    background: var(--color-text-primary);\n  }\n}\n\n\/* ---------- image frames: explicit shape-policy wrappers ---------- *\/\n.mms-img {\n  display: block;\n  background: transparent;\n  border-radius: 0;\n  clip-path: none;\n}\n.mms-frame {\n  position: relative;\n  display: block;\n  flex: 0 0 auto;\n  overflow: hidden;\n  box-sizing: border-box;\n  border-radius: 0;\n  clip-path: none;\n  background: transparent;\n}\n.mms-frame > .mms-img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  max-width: none;\n  object-fit: contain;\n  object-position: 50% 50%;\n  border-radius: 0;\n  clip-path: none;\n}\n.mms-frame[data-shape-policy=\"artwork\"] {\n  background: var(--color-bg-page);\n}\n.mms-frame[data-fit=\"cover\"] > .mms-img {\n  object-fit: cover;\n  object-position: var(--object-position, 50% 50%);\n}\n\/* The uploaded Touchbaes booking poster contains one unintended light source\n   column at its far right. Its declared 403:504 frame is the correct crop;\n   cover from the left removes only that source seam at every rendition size. *\/\n.mms-frame[data-media-id=\"touchbaes-03\"] > .mms-img {\n  object-fit: cover !important;\n  object-position: 0% 50% !important;\n}\n\n\/* Montran is wrapped only to separate compact gesture ownership from the\n   cross-origin page-turner. Expanded mode leaves the iframe fully native. *\/\n.mms-booklet-shell {\n  position: relative;\n  display: block;\n  flex: 0 0 auto;\n  overflow: hidden;\n  background: #000;\n}\n.mms-booklet-shell > .mms-booklet {\n  width: 100%;\n  height: 100%;\n  border: 0;\n}\n.mms-booklet-gesture { display: none; }\n[data-shape=\"rounded\"] .mms-frame {\n  border-radius: var(--radius-image);\n  clip-path: inset(0 round var(--radius-image));\n}\n[data-shape=\"oval\"] .mms-frame {\n  border-radius: 50%;\n  clip-path: ellipse(50% 50% at 50% 50%);\n}\n\/* The booklet shell is the sole shape-responsive interactive frame. V7 and\n   Touchbaes remain direct rectangular embeds. *\/\n[data-shape=\"rounded\"] .mms-booklet-shell {\n  border-radius: var(--radius-image);\n  clip-path: inset(0 round var(--radius-image));\n}\n[data-shape=\"oval\"] .mms-booklet-shell {\n  border-radius: 50%;\n  clip-path: ellipse(50% 50% at 50% 50%);\n}\n[data-shape-policy=\"interactive\"]:not(.mms-booklet-shell) {\n  border-radius: 0 !important;\n  clip-path: none !important;\n}\n\n\/* ---------- control panel internals ---------- *\/\n\/* header (title + close): shown only in the mobile sheet \u2014 the desktop rail\n   panel has no header, matching Figma. Base styles live here; the mobile\n   query flips .mms-panel-head to flex. *\/\n.mms-panel-title {\n  font-family: var(--font-family-base) !important;\n  font-size: calc(20 * var(--chrome-u)) !important;\n  font-weight: normal;\n}\n.mms-close { width: 44px; height: 44px; padding: 0; border: 0; background: transparent; cursor: pointer; }\n.mms-close svg { width: calc(24 * var(--chrome-u)); height: calc(24 * var(--chrome-u)); stroke: var(--color-text-primary); stroke-width: 1; fill: none; }\n.mms-panel-link { display: none; }\n.mms-panel-inline { display: none; }\n.mms-inline-plus {\n  display: none;\n  font: inherit;\n  line-height: inherit;\n  vertical-align: baseline;\n  transform: translateY(var(--inline-plus-optical-y, 0.092em));\n  transform-origin: center;\n}\n[data-face=\"sans\"] .mms-inline-plus { --inline-plus-optical-y: -0.005em; }\n[data-face=\"mono\"] .mms-inline-plus { --inline-plus-optical-y: 0.128em; }\n[data-face=\"gothic\"] .mms-inline-plus { --inline-plus-optical-y: 0.08em; }\n\n.mms-panel .row { display: flex; gap: var(--chrome-space-8); }\n.mms-panel-primary { display: contents; }\n.mms-panel .row.dots { order: 1; }\n.mms-panel .mms-scale { order: 2; }\n.mms-panel .row.grid2 { order: 3; }\n.mms-panel .mms-shapes { order: 4; }\n.mms-panel .row.dots { justify-content: space-between; align-items: center; height: 44px; }\n.mms-panel .row.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--chrome-space-8); }\n\n.mms-dot {\n  width: 44px; height: 44px; border: 0; border-radius: 0;\n  background: transparent; cursor: pointer; padding: 0; position: relative;\n}\n.mms-dot::before {\n  content: \"\"; position: absolute; top: 50%; left: 50%;\n  width: calc(20 * var(--panel-control-u)); height: calc(20 * var(--panel-control-u));\n  transform: translate(-50%, -50%); border: 1px solid var(--color-border);\n  border-radius: 50%; background: var(--dot-bg);\n}\n\/* selected indicator = a small CENTER CIRCLE (radio-button semantics, per\n   Figma Swatch). aspect-ratio:1 keeps it circular even when the dot itself is\n   a stretched oval (mobile) \u2014 height tracks the dot so it's 12px on the 20px\n   desktop dot, 16px on the 24px mobile dot. *\/\n.mms-dot::after {\n  content: \"\"; position: absolute; top: 50%; left: 50%;\n  height: calc(12 * var(--panel-control-u)); aspect-ratio: 1; transform: translate(-50%, -50%);\n  border-radius: 50%;\n  background: var(--dot-center, transparent); opacity: 0;\n}\n.mms-dot[aria-pressed=\"true\"]::after { opacity: 1; }\n\n.mms-btn {\n  position: relative; isolation: isolate; height: 44px; border: 0; border-radius: 0;\n  background: transparent; color: var(--color-text-primary);\n  font-size: calc(14 * var(--chrome-u)); cursor: pointer;\n  font-family: var(--font-family-base);\n}\n.mms-btn::before {\n  content: \"\"; position: absolute; z-index: -1; left: 0; right: 0; top: 50%;\n  height: calc(32 * var(--panel-control-u)); transform: translateY(-50%);\n  border: 1px solid var(--color-border); background: var(--color-bg-page);\n}\n.mms-btn[aria-pressed=\"true\"] { background: transparent; color: var(--color-bg-page); }\n.mms-btn[aria-pressed=\"true\"]::before { background: var(--color-text-primary); }\n\/* per-face preview labels keep their own faces AND a fixed Medium-scale\n   caption size (16\/15.5\/14.4\/16 since Type Scale v2 2026-07-10, x-height-\n   normalized) \u2014 the panel buttons do NOT grow with the type-scale slider\n   (Ocean). They ride --chrome-u so they scale only until the 1800px cap,\n   unlike the body type which is fixed. Slider a's stay 14\/28 (iconographic,\n   Figma panel component; row heights are locked). *\/\n.mms-btn.face-serif  { font-family: \"Times New Roman\", Times, serif; font-size: calc(16 * var(--chrome-u)); }\n.mms-btn.face-sans   { font-family: \"TeX Gyre Heros Condensed\", \"TeX Gyre Heros Cn\", sans-serif; font-size: calc(15.5 * var(--chrome-u)); }\n.mms-btn.face-mono   { font-family: \"Gaisyr Semi-Mono\", \"ABC Gaisyr Semi Mono\", monospace; font-size: calc(14.4 * var(--chrome-u)); }\n.mms-btn.face-gothic { font-family: \"UnifrakturMaguntia\", serif; font-size: calc(16 * var(--chrome-u)); }\n\n\/* Expanded control labels use the desktop breakpoint's Medium type scale.\n   !important defeats Cargo's later generic button font-size rule. *\/\n@media (min-width: 1024px) {\n  \/* Figma desktop panel: 24-unit vertical and 16-unit horizontal padding.\n     Subtract the 1px border so the visible inset lands on the token value.\n     Keep the root qualifier because Cargo's editor retains a later compiled\n     stylesheet while it previews the newly saved global CSS. *\/\n  .mms dialog.mms-panel {\n    padding:\n      calc(var(--panel-pad-block-expanded) - 1px)\n      calc(var(--panel-pad-inline-expanded) - 1px);\n  }\n  .mms-btn.face-serif  { font-size: 18px !important; }\n  .mms-btn.face-sans   { font-size: 17.4px !important; }\n  .mms-btn.face-mono   { font-size: 16.2px !important; }\n  .mms-btn.face-gothic { font-size: 16.6px !important; }\n  .mms-face-label {\n    display: flex; align-items: center; justify-content: center;\n    width: 100%; height: 100%; line-height: 21px;\n  }\n  .face-sans .mms-face-label { transform: translateY(-1px); }\n  .face-gothic .mms-face-label { transform: translateY(2px); }\n}\n\n\/* slider row: a --o-- a, 4 steps. The a's are lowercase, whose glyph mass\n   sits below the line-box center; translateY(-0.14em) lifts each glyph so\n   the horizontal line runs through its visual middle (em-scaled so both\n   sizes shift proportionally). Row is tall enough for the 28px 'a'. *\/\n.mms-scale { display: flex; align-items: center; gap: var(--chrome-space-8); height: 44px; }\n.mms-scale .a-min {\n  font-family: var(--font-family-base) !important;\n  font-size: 18px !important;\n  line-height: 1; transform: translateY(-0.114em);\n}\n.mms-scale .a-max {\n  font-family: var(--font-family-base) !important;\n  font-size: 36px !important;\n  line-height: 1; transform: translateY(-0.114em);\n}\n.mms-scale input[type=\"range\"] {\n  flex: 1; min-width: 0; -webkit-appearance: none; appearance: none;\n  height: 44px; background: linear-gradient(var(--color-text-primary), var(--color-text-primary)) center \/ 100% 1px no-repeat;\n}\n.mms-scale input[type=\"range\"]::-webkit-slider-thumb {\n  -webkit-appearance: none; width: calc(12 * var(--panel-control-u)); height: calc(12 * var(--panel-control-u)); border-radius: 50%;\n  background: var(--color-bg-page); border: 1px solid var(--color-text-primary);\n  box-shadow: none; \/* Safari draws a default thumb shadow (Ocean: remove) *\/\n}\n.mms-scale input[type=\"range\"]::-moz-range-thumb {\n  width: calc(12 * var(--panel-control-u)); height: calc(12 * var(--panel-control-u)); border-radius: 50%;\n  background: var(--color-bg-page); border: 1px solid var(--color-text-primary);\n  box-shadow: none;\n}\n\n\/* shape options: straight < rounded < oval (optical sizes), 36px row *\/\n.mms-shapes { display: flex; gap: var(--chrome-space-8); height: 44px; align-items: center; }\n.mms-shape { position: relative; isolation: isolate; flex: 1; height: 44px; border: 0; background: transparent;\n  cursor: pointer; display: grid; place-items: center; padding: 0; }\n.mms-shape::before { content: \"\"; position: absolute; z-index: -1; inset-inline: 0; top: 50%; transform: translateY(-50%); border: 1px solid var(--color-border); background: var(--color-bg-page); }\n.mms-shape svg { width: calc(24 * var(--panel-control-u)); height: calc(24 * var(--panel-control-u)); fill: var(--color-text-primary); }\n.mms-shape.straight::before { height: min(calc(32 * var(--panel-control-u)), 44px); border-radius: 0; }\n.mms-shape.rounded::before { height: min(calc(34 * var(--panel-control-u)), 44px); border-radius: 6px; }\n.mms-shape.oval::before { height: min(calc(36 * var(--panel-control-u)), 44px); border-radius: 50%; }\n.mms-shape[aria-pressed=\"true\"] { background: transparent; }\n.mms-shape[aria-pressed=\"true\"]::before { background: var(--color-text-primary); }\n.mms-shape[aria-pressed=\"true\"] svg { fill: var(--color-bg-page); }\n\n.mms :focus-visible {\n  outline: 1px dotted var(--color-border);\n  outline-offset: 3px;\n}\n\n\/* ---------- Round 15 (2026-07-11) ---------- *\/\n\/* hairline borders: WebKit letterboxes sub-pixel aspect mismatches inside\n   the video box (black bars on Safari\/iOS, page-bg slivers in Chromium) \u2014\n   my -2 rescales drifted some aspects ~0.03%. cover crops the mismatch. *\/\n\/* Media fitting is owned by .mms-frame[data-fit], not the replaced element. *\/\n\/* top alignment: the intro's FIRST paragraph inherited the paragraph-rhythm\n   margin (--lh-base = 25px), pushing the whole 0-height sticky head below\n   its own pin offset \u2014 misaligned with the MM.S wordmark at rest AND\n   sliding 25px before pinning (\"scrolls a little\"). *\/\n\/* !important: the mobile-editor neutralizer re-asserts .mms-intro p margins\n   with !important; higher specificity wins the important contest *\/\n.mms-intro p:first-child { margin-top: 0 !important; }\n\/* slider a-glyphs: the flat -0.114em lift was tuned on serif@28. Optical\n   centers measured per face via TextMetrics (fontBoundingBox + ink box):\n   sans\/mono want -0.131em at both sizes; gothic sits much lower in its\n   line box and wants nearly none (-0.007\/-0.025). *\/\n[data-face=\"sans\"] .mms-scale .a-min, [data-face=\"sans\"] .mms-scale .a-max,\n[data-face=\"mono\"] .mms-scale .a-min, [data-face=\"mono\"] .mms-scale .a-max {\n  transform: translateY(-0.131em);\n}\n[data-face=\"gothic\"] .mms-scale .a-min { transform: translateY(-0.007em); }\n[data-face=\"gothic\"] .mms-scale .a-max { transform: translateY(-0.025em); }\n\/* Hover belongs only to devices that can sustain it. Touch uses active\n   feedback so iOS never retains a sticky hover state. *\/\n@media (hover: hover) and (pointer: fine) {\n  .mms a:hover { font-weight: bold; }\n  .mms-btn:hover { color: var(--color-bg-page); }\n  .mms-btn:hover::before { background: var(--color-text-primary); }\n  .mms-shape:hover::before { background: var(--color-text-primary); }\n  .mms-shape:hover svg { fill: var(--color-bg-page); }\n  .mms-dot:hover::before { box-shadow: 0 0 0 1px var(--color-border); }\n  .mms-scale input[type=\"range\"]::-webkit-slider-thumb:hover { background: var(--color-text-primary); }\n  .mms-scale input[type=\"range\"]::-moz-range-thumb:hover { background: var(--color-text-primary); }\n}\n.mms button:active { opacity: 0.72; }\n\n\/* Fine-pointer expanded panels use Figma's optical 20\/24\/32\/36px rows.\n   Outer padding and group gaps continue following --chrome-u, while the\n   controls themselves stop shrinking below their 1440 reference sizes. *\/\n@media (min-width: 1024px) and (hover: hover) and (pointer: fine) {\n  .mms-panel .row.dots {\n    height: calc(20 * var(--panel-control-u));\n  }\n  .mms-panel .row.grid2 {\n    gap: calc(8 * var(--panel-control-u));\n  }\n  .mms-dot {\n    width: calc(20 * var(--panel-control-u));\n    height: calc(20 * var(--panel-control-u));\n  }\n  .mms-btn { height: calc(32 * var(--panel-control-u)); }\n  .mms-scale,\n  .mms-scale input[type=\"range\"] {\n    height: calc(24 * var(--panel-control-u));\n  }\n  .mms-shapes,\n  .mms-shape { height: calc(36 * var(--panel-control-u)); }\n  .mms-shape.straight::before { height: calc(32 * var(--panel-control-u)); }\n  .mms-shape.rounded::before { height: calc(34 * var(--panel-control-u)); }\n  .mms-shape.oval::before { height: calc(36 * var(--panel-control-u)); }\n}\n\n\/* The render preview is a sequence of hard design-state cuts. Do not soften\n   these changes: the raw redraw is the intended loading\/rendering gesture. *\/\nhtml[data-render-preview] body,\nhtml[data-render-preview] .mms,\nhtml[data-render-preview] .mms-rail,\nhtml[data-render-preview] .mms-mbar .mbar-row,\nhtml[data-render-preview] .mms-mbar .mms-mlinks,\nhtml[data-render-preview] dialog.mms-panel {\n  transition: none !important;\n}\nhtml[data-render-preview] .mms-img,\nhtml[data-render-preview] .mms-frame { transition: none !important; }\n\n\/* ---------- COMPACT (<1024): bar \/ flow intro \/ covering bands \/ dialog sheet ---------- *\/\n@media (max-width: 1023px) {\n  :root {\n    --panel-toggle-visual-size: 24px;\n    --panel-toggle-glyph-size: 20px;\n    --panel-block-pad: 22px;\n    --mbar-control-optical-y: 0px;\n  }\n  html[data-scale=\"s\"] {\n    --panel-toggle-visual-size: 22px;\n    --panel-toggle-glyph-size: 17px;\n  }\n  html[data-scale=\"m\"] {\n    --panel-toggle-visual-size: 24px;\n    --panel-toggle-glyph-size: 20px;\n  }\n  html[data-scale=\"l\"] {\n    --panel-toggle-visual-size: 26px;\n    --panel-toggle-glyph-size: 24px;\n  }\n  html[data-scale=\"xl\"] {\n    --panel-toggle-visual-size: 28px;\n    --panel-toggle-glyph-size: 28px;\n  }\n  html[data-face=\"sans\"] { --mbar-control-optical-y: 1px; }\n  html[data-face=\"mono\"] { --mbar-control-optical-y: 0px; }\n  html[data-face=\"gothic\"] { --mbar-control-optical-y: -2px; }\n  .mms {\n    --mobile-media-w: 85vw;\n    --mobile-wide-media-w: 150vw;\n    --mobile-loop-cover-w: 110vw;\n    --mobile-booklet-w: 150vw;\n    --mobile-small-media-w: 58vw;\n    --mobile-panorama-w: 128vw;\n    --mobile-deadgood-wide-w: 110vw;\n    --mobile-standard-h: 58svh;\n    --mobile-panorama-h: 32svh;\n    --mobile-game-w: min(100vw, calc(98vw + 5px));\n    --mobile-game-left: calc(32px + (var(--mobile-game-w) * 5.25 \/ 100));\n    --mobile-game-right: 36px;\n    --mobile-game-bottom: calc(31px + (var(--mobile-game-w) * 19.3 \/ 100));\n  }\n  .mms { display: block; }\n  .mms-rail { display: none; }\n  .mms-panel:not(dialog) { display: none; }\n\n  \/* Touchbaes compact fallback applies only before the game's measured\n     visual-envelope message arrives. The child becomes the sole height\n     authority after that first validated message. *\/\n  .mms-band iframe[src*=\"touchbaes\"],\n  .mms-band iframe[data-src*=\"touchbaes\"] {\n    width: var(--mobile-game-px-width, var(--mobile-game-w)) !important;\n    height: var(--mobile-game-px-height, calc(\n      24px +\n      ((var(--mobile-game-w) - var(--mobile-game-left) - var(--mobile-game-right)) * 1752 \/ 1586) +\n      var(--mobile-game-bottom)\n    )) !important;\n  }\n\n  \/* sticky top bar: MM.S + menu button + clock. Middle layer (z10):\n     the intro slides UNDER it, the bands slide OVER it. *\/\n  \/* bar = wordmark row + nav links, ALL sticky (\"treat them like the nav\n     bar\" \u2014 Ocean). Bands cover the whole block when passing: intentional. *\/\n  .mms-mbar {\n    display: contents;\n  }\n  .mms-mbar .mbar-row {\n    display: flex; align-items: center; gap: var(--space-12); min-height: 44px;\n    position: sticky; top: 0; z-index: 10;\n    padding: max(var(--space-16), env(safe-area-inset-top)) var(--margin-page) var(--space-16);\n    background: transparent;\n    isolation: isolate;\n  }\n  \/* Keep the edge-adjacent sticky row transparent in every state. Safari 26\n     can retain a solid toolbar extension after sampling any opaque sticky\n     surface here, even after the page later changes it back. Disposable fixed\n     samplers supply only the startup colors; the real .mms composition owns\n     the transparent landing and scrolling content beneath Safari's material. *\/\n  \/* Do not paint a separate safe-area\/header plate. With viewport-fit=cover,\n     the real page surface can extend behind Safari's translucent material.\n     Padding still keeps the title, clock, and control clear of system UI. *\/\n  .mms-mbar .mbar-row::before {\n    content: none;\n  }\n  .mms-intro-wrap > .mms-mlinks {\n    display: block; position: sticky; top: var(--mbar-row-h, 76px); z-index: 10;\n    padding: var(--space-24) var(--margin-page) var(--space-16);\n    \/* Safari 26 derives toolbar tint from sticky\/fixed backgrounds near the\n       obscured viewport edge. Keep this sticky geometry, but let the actual\n       page\/showcase surface paint through instead of exposing a flash theme. *\/\n    background: transparent;\n  }\n  .mms-mlinks ul { list-style: none; }\n  .mms-mlinks ul + ul { margin-top: var(--lh-base); }\n  .mms-mlinks a {\n    display: block;\n    min-height: 0;\n    line-height: var(--lh-base);\n  }\n  .mms-menu {\n    display: grid; place-items: center; position: relative;\n    width: var(--panel-toggle-visual-size); height: var(--panel-toggle-visual-size);\n    \/* Cargo's editor button styles inherit the page type size after this\n       bundle. Pin the optical icon box to its own scale token. *\/\n    font-size: var(--panel-toggle-glyph-size) !important;\n    margin-left: 0;\n    padding: 0; border: 0; background: transparent; cursor: pointer;\n    -webkit-appearance: none; appearance: none;\n    -webkit-tap-highlight-color: transparent;\n    box-shadow: none; filter: none;\n  }\n  \/* The visual\/focus box fits the icon. A transparent 44px pseudo target\n     preserves the approved touch area without producing an oversized iOS\n     tap highlight or moving the icon's right edge. *\/\n  .mms-menu::before {\n    content: \"\"; position: absolute;\n    inset: calc((var(--panel-toggle-visual-size) - 44px) \/ 2);\n  }\n  .mms-toggle-icon {\n    display: grid; place-items: center;\n    width: var(--panel-toggle-visual-size); height: var(--panel-toggle-visual-size);\n    color: var(--color-text-primary);\n    background: transparent;\n    transform: translateY(var(--mbar-control-optical-y));\n  }\n  .mms-toggle-icon svg {\n    display: block;\n    width: var(--panel-toggle-glyph-size) !important;\n    height: var(--panel-toggle-glyph-size) !important;\n    fill: none;\n    stroke: currentColor;\n  }\n  .mms-toggle-close { display: none; background: var(--color-text-primary); }\n  .mms-toggle-close svg { stroke: var(--color-bg-page); }\n  .mms-menu[aria-expanded=\"true\"] .mms-toggle-plus { display: none; }\n  .mms-menu[aria-expanded=\"true\"] .mms-toggle-close { display: grid; }\n  .mms-clock-m { margin-left: auto; color: var(--color-text-primary); font-variant-numeric: tabular-nums; }\n\n  .mms-menu:focus { outline: none; }\n  .mms-menu:focus-visible { outline: none; }\n  .mms-menu:focus-visible .mms-toggle-icon {\n    outline: 1.5px solid var(--color-text-primary);\n    outline-offset: 2px;\n  }\n\n  .mms-main { padding: 0; }\n\n  \/* intro-wrap = containing block for the sticky intro; it holds the intro +\n     the FIRST band, so the intro pins while the first work scrolls up over it\n     and RELEASES (scrolls out under the bar) once the first work has passed.\n     NO z-index here on purpose: a z-index would create a stacking context that\n     traps the first band's z20 below the bar (z10). Without it, the first\n     band's z20 competes with the bar directly, so the showcase covers the\n     bar + links too (Ocean). position:relative alone doesn't make a context. *\/\n  .mms-intro-wrap { display: block; position: relative; overflow: visible; }\n  \/* intro block: STATIC (pinned) just below the sticky bar (--bar-h, set by\n     panel.js). z1 < bands z20, so the first work covers it; z1 < bar z10, so\n     it slides out under the bar when released. *\/\n  .mms-sticky-head {\n    position: sticky; top: var(--bar-h, 200px); height: auto; z-index: 1;\n    background: transparent;\n    padding: var(--space-24) var(--margin-page) var(--space-40);\n  }\n  .mms-intro { width: auto !important; }\n  .mms-panel-copy { display: none; }\n  .mms-panel-link { display: none; }\n  .mms-inline-plus { display: inline-block; }\n  .mms-panel-inline {\n    display: inline;\n    color: inherit; font: inherit; line-height: inherit; vertical-align: baseline;\n  }\n  .mms-clock { display: none; } \/* the bar carries the mobile clock *\/\n  .mms-intro-spacer { display: none; }\n\n  \/* bands: TRANSPARENT (z20, above the bar). Only the images (opaque) and\n     the description plate cover the nav as they pass; the nav shows through\n     everywhere else. The band itself carries no fill \u2014 \"images should not\n     have a white fill, only the description\" (Ocean).\n     Left edge = --margin-page, same as the intro text; river bleeds off the\n     right edge and scrolls horizontally. *\/\n  .mms-band {\n    position: relative; z-index: 20;\n    background: transparent;\n    padding: 0;\n    overflow: visible;\n    content-visibility: visible;\n    contain: none;\n    contain-intrinsic-size: none;\n  }\n  .mms-intro-wrap > .mms-band { padding-top: var(--space-40); }\n  .mms-band + .mms-band,\n  .mms-intro-wrap + .mms-band { margin-top: var(--space-64); } \/* transparent gap: bar resurfaces between projects *\/\n  .mms-river {\n    --river-gap: clamp(16px, 3vw, 24px);\n    width: 100vw;\n    height: auto !important;\n    gap: var(--river-gap);\n    padding-inline: 0;\n    pointer-events: auto;\n    touch-action: pan-x pan-y;\n  }\n  \/* Resting margins are scrollable flex spacers, not permanent scroller\n     padding. Once the visitor pans, imagery can become truly flush with the\n     physical left\/right viewport edges and Safari's edge material. *\/\n  .mms-river::before,\n  .mms-river::after {\n    content: \"\";\n    flex: 0 0 max(0px, calc(var(--margin-page) - var(--river-gap)));\n    width: max(0px, calc(var(--margin-page) - var(--river-gap)));\n    height: 1px;\n    pointer-events: none;\n  }\n  .mms-river > * { pointer-events: auto; }\n  .mms-river > [style*=\"--asset-w\"] {\n    --asset-u: min(\n      calc(var(--mobile-media-w) \/ var(--asset-w)),\n      calc(var(--mobile-standard-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"small\"] {\n    --asset-u: min(\n      calc(var(--mobile-small-media-w) \/ var(--asset-w)),\n      calc(var(--mobile-standard-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"wide\"] {\n    --asset-u: min(\n      calc(var(--mobile-wide-media-w) \/ var(--asset-w)),\n      calc(52svh \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"loop-cover\"] {\n    --asset-u: min(\n      calc(var(--mobile-loop-cover-w) \/ var(--asset-w)),\n      calc(var(--mobile-standard-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"booklet-wide\"] {\n    --asset-u: min(\n      calc(var(--mobile-booklet-w) \/ var(--asset-w)),\n      calc(var(--mobile-standard-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"panorama\"] {\n    --asset-u: min(\n      calc(var(--mobile-panorama-w) \/ var(--asset-w)),\n      calc(var(--mobile-panorama-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river > [data-mobile-profile=\"deadgood-wide\"] {\n    --asset-u: min(\n      calc(var(--mobile-deadgood-wide-w) \/ var(--asset-w)),\n      calc(var(--mobile-standard-h) \/ var(--asset-h))\n    );\n  }\n  .mms-river .offset { display: none; }\n  .mms-band[data-offset] { --offset: 0px; }\n  .mms-desc {\n    width: calc(100vw - (2 * var(--margin-page)));\n    margin-left: var(--margin-page);\n    padding-right: 0;\n  }\n  [data-band=\"eviive\"] .mms-desc, [data-band=\"v7\"] .mms-desc,\n  [data-band=\"loop\"] .mms-desc, [data-band=\"kelly\"] .mms-desc,\n  [data-band=\"deadgood\"] .mms-desc {\n    width: calc(100vw - (2 * var(--margin-page))) !important;\n  }\n\n  \/* Compact JS portals this non-modal dialog under body so fixed positioning\n     remains viewport-relative outside Cargo's transformed page wrappers. *\/\n  dialog.mms-panel {\n    display: none;\n    position: fixed;\n    --panel-inline: 20px;\n    inset: auto 0 0 0;\n    box-sizing: border-box;\n    width: 100vw; max-width: none; max-height: calc(100svh - 16px); overflow-y: auto;\n    overscroll-behavior: contain; touch-action: pan-y; z-index: 40;\n    --font-scale: 1;\n    font-family: var(--font-family-base);\n    color: var(--color-text-primary);\n    background-color: var(--color-bg-page) !important;\n    background-image: none !important;\n    isolation: isolate;\n    margin: 0;\n    border: 1px solid var(--color-border); border-bottom: 0;\n    border-inline: 0;\n    padding: var(--panel-block-pad) var(--panel-inline) max(var(--panel-block-pad), calc(env(safe-area-inset-bottom) + 8px));\n    gap: var(--space-16);\n  }\n  \/* The shared desktop rail ships native-open so it paints before JavaScript.\n     In compact mode, that attribute alone must never expose the tray: only an\n     explicit user-open state on the root can make it visible. *\/\n  html[data-panel=\"open\"] dialog.mms-panel[open] { display: flex; }\n  dialog.mms-panel::backdrop { display: none; }\n  \/* Updated Figma compact panel: no internal title row. Palette and scale\n     share the first 24px optical row.\n     Five transparent flex cells center true 24px circles, so the visible\n     color marks never merge even as their touch cells compress. *\/\n  .mms-panel-primary {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: var(--space-8);\n    align-items: center;\n    order: 1;\n    flex: 0 0 24px; height: 24px;\n    margin: 0;\n    overflow: visible;\n    box-sizing: border-box;\n    padding-inline: 2px !important;\n  }\n  .mms-panel .row.grid2 { order: 2; }\n  .mms-panel .mms-shapes { order: 3; }\n  .mms-panel .row.dots {\n    grid-column: 2;\n    grid-row: 1;\n    order: 1;\n    height: 24px;\n    gap: 0;\n    position: relative;\n  }\n  .mms-dot { flex: 1 1 0; width: auto; height: 44px; border: 0; position: static; background: transparent !important; }\n  .mms-dot::before {\n    content: \"\"; position: absolute; inset: auto;\n    top: 50%; left: 50%; width: 24px; height: 24px;\n    transform: translate(-50%, -50%);\n    border: 1px solid var(--color-border); border-radius: 50%;\n    background: var(--dot-bg);\n  }\n  \/* Five visible 24px dots distribute across the complete palette span.\n     Their edge-to-edge gaps are equal at every compact width while the five\n     transparent flex cells continue to own the interaction regions. *\/\n  .mms-panel .row.dots .mms-dot:nth-child(1)::before,\n  .mms-panel .row.dots .mms-dot:nth-child(1)::after { left: 12px; }\n  .mms-panel .row.dots .mms-dot:nth-child(2)::before,\n  .mms-panel .row.dots .mms-dot:nth-child(2)::after { left: calc(25% + 6px); }\n  .mms-panel .row.dots .mms-dot:nth-child(3)::before,\n  .mms-panel .row.dots .mms-dot:nth-child(3)::after { left: 50%; }\n  .mms-panel .row.dots .mms-dot:nth-child(4)::before,\n  .mms-panel .row.dots .mms-dot:nth-child(4)::after { left: calc(75% - 6px); }\n  .mms-panel .row.dots .mms-dot:nth-child(5)::before,\n  .mms-panel .row.dots .mms-dot:nth-child(5)::after { left: calc(100% - 12px); }\n  .mms-dot::after { height: 12px; z-index: 1; }\n  \/* face buttons: single 4-across row on mobile (Figma sheet), not desktop 2x2 *\/\n  .mms-panel .row.grid2 {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    flex: 0 0 36px; height: 36px; gap: var(--space-8); overflow: visible;\n    margin: 0;\n    align-items: center;\n    box-sizing: border-box;\n    padding-inline: 2px !important;\n  }\n  .mms-btn {\n    position: relative; isolation: isolate; height: 44px; border: 0;\n    background: transparent; color: var(--color-text-primary);\n    display: flex; align-items: center; justify-content: center; line-height: 18px;\n  }\n  .mms-btn::before {\n    content: \"\"; position: absolute; inset-inline: 0; top: 50%; z-index: -1;\n    height: 36px; transform: translateY(-50%);\n    border: 1px solid var(--color-border); background: var(--color-bg-page);\n  }\n  .mms-btn::after { content: \"\"; position: absolute; inset: 0; }\n  .mms-btn[aria-pressed=\"true\"] { background: transparent; color: var(--color-bg-page); }\n  .mms-btn[aria-pressed=\"true\"]::before { background: var(--color-text-primary); }\n  .mms-btn.face-serif { font-size: 20px !important; line-height: 23px; }\n  .mms-btn.face-sans { font-size: 19.3px !important; line-height: 23px; }\n  .mms-btn.face-mono { font-size: 18px !important; line-height: 23px; }\n  .mms-btn.face-gothic { font-size: 18.4px !important; line-height: 23px; }\n  .mms-face-label {\n    display: flex; align-items: center; justify-content: center;\n    box-sizing: border-box; width: 100%; height: 36px; line-height: 23px;\n  }\n  .face-serif .mms-face-label { padding: 4px 8px; }\n  .face-sans .mms-face-label { padding: 3px 8px 5px; }\n  .face-mono .mms-face-label { padding: 4px 8px; }\n  .face-gothic .mms-face-label { padding: 6px 8px 2px; }\n  \/* slider: 44px touch track, 24px optical row *\/\n  .mms-scale {\n    grid-column: 1;\n    grid-row: 1;\n    order: 1;\n    width: 100%;\n    min-width: 0;\n    height: 24px;\n    gap: var(--space-4);\n    overflow: visible;\n    box-sizing: border-box;\n    padding-inline: 4px !important;\n  }\n  .mms-scale .a-min { font-size: 17px !important; }\n  .mms-scale .a-max { font-size: 30px !important; }\n  .mms-scale input[type=\"range\"] {\n    height: 44px; background: linear-gradient(var(--color-text-primary), var(--color-text-primary)) center \/ 100% 1px no-repeat;\n  }\n  .mms-shapes { flex: 0 0 42px; height: 42px; overflow: visible; margin: 0; align-items: center; }\n  .mms-shape { position: relative; height: 44px !important; border: 0; background: transparent; isolation: isolate; }\n  .mms-shape::before {\n    content: \"\"; position: absolute; box-sizing: border-box; inset-inline: 0; z-index: -1;\n    border: 1px solid var(--color-border); background: var(--color-bg-page);\n  }\n  .mms-shape::after { content: \"\"; position: absolute; inset: 0; }\n  .mms-shape.straight::before { height: 38px; top: 3px; transform: none; border-radius: 0; }\n  .mms-shape.rounded::before { height: 40px; top: 2px; transform: none; border-radius: 6px; }\n  .mms-shape.oval::before { height: 42px; top: 1px; transform: none; border-radius: 50%; }\n  .mms-shape[aria-pressed=\"true\"] { background: transparent; }\n  .mms-shape[aria-pressed=\"true\"]::before { background: var(--color-text-primary); }\n}\n\n\/* Once the sheet no longer needs the complete phone width, keep the exact\n   compact composition and align it to the right. Orientation never changes\n   the control-panel structure. *\/\n@media (min-width: 431px) and (max-width: 759px) {\n  dialog.mms-panel {\n    width: min(390px, calc(100vw - 32px));\n    inset: auto 16px 0 auto;\n    transform: none;\n    border: 1px solid var(--color-border); border-bottom: 0;\n  }\n}\n\n\/* 390px panel + 24px insets leaves at least ~320px of portfolio preview. *\/\n@media (min-width: 760px) and (max-width: 1023px) {\n  dialog.mms-panel {\n    width: 390px;\n    inset: auto 24px 24px auto;\n    transform: none;\n    border: 1px solid var(--color-border);\n  }\n}\n\n\/* ---------- Cargo mobile-offset neutralizer \u2014 KEEP THIS SECTION LAST ---------- *\/\n\/* Cargo's mobile editor generates a #mobile-offset-styles sheet: clones of\n   every padding\/margin declaration scaled by var(--mobile-padding-offset),\n   injected AFTER this stylesheet (and one clone selector, \".mms *\", leaks\n   unprefixed into desktop too). Their clones carry no !important, so these\n   re-assertions always win in both editor modes and on the live site. *\/\n.mms { margin-inline: 0 !important; padding: 0 !important; }\n.mms * { margin: 0 !important; padding: 0 !important; }\n.mms-rail { padding: var(--edge-pad) var(--chrome-space-32) var(--edge-pad) var(--edge-pad) !important; }\n.mms-rail ul { margin-top: var(--chrome-space-24) !important; }\n.mms-rail a, .mms-mlinks a { padding-block: 0 !important; }\n.mms-panel { padding: var(--chrome-space-16) !important; margin: 0 var(--chrome-space-32) var(--edge-pad) var(--edge-pad) !important; }\n.mms-main { padding: var(--edge-pad) 0 var(--edge-pad) 0 !important; }\n.mms-intro p { margin-top: var(--lh-base) !important; }\n.mms-band + .mms-band,\n.mms-intro-wrap + .mms-band { margin-top: var(--space-192) !important; }\n.mms-river { padding-right: var(--edge-pad) !important; }\n.mms-desc { margin-left: var(--offset, 0px) !important; padding-top: var(--space-16) !important; }\n.mms-desc p, .mms-desc .url { margin-top: var(--space-8) !important; }\n@media (max-width: 1023px) {\n  .mms-mbar .mbar-row {\n    padding: max(var(--space-16), env(safe-area-inset-top)) var(--margin-page) var(--space-16) !important;\n  }\n  .mms-menu { margin-left: 0 !important; }\n  .mms-intro-wrap > .mms-mlinks {\n    padding: var(--space-24) var(--margin-page) var(--space-16) !important;\n    margin-top: 0 !important;\n  }\n  .mms-mlinks ul + ul { margin-top: var(--lh-base) !important; }\n  .mms-clock-m { margin-left: auto !important; }\n  .mms-main { padding: 0 0 var(--space-64) !important; }\n  .mms-sticky-head { padding: var(--space-24) var(--margin-page) var(--space-40) !important; }\n  .mms-band { padding: 0 !important; }\n  .mms-intro-wrap > .mms-band { padding-top: var(--space-40) !important; }\n  .mms-band + .mms-band,\n  .mms-intro-wrap + .mms-band { margin-top: var(--space-64) !important; }\n  .mms-river { padding-inline: 0 !important; }\n  .mms-desc { margin-left: var(--margin-page) !important; padding-right: 0 !important; padding-top: var(--space-16) !important; }\n  dialog.mms-panel[open] {\n    padding: var(--panel-block-pad) var(--panel-inline) max(var(--panel-block-pad), calc(env(safe-area-inset-bottom) + 8px)) !important;\n    margin: 0 !important;\n  }\n  dialog.mms-panel .mms-panel-primary {\n    margin: 0 !important;\n    padding-inline: 2px !important;\n  }\n  dialog.mms-panel .row.grid2 { margin: 0 !important; padding-inline: 2px !important; }\n  dialog.mms-panel .mms-scale { padding-inline: 4px !important; }\n  dialog.mms-panel .mms-shapes { margin: 0 !important; }\n}\n@media (min-width: 1024px) {\n  .mms dialog.mms-panel {\n    padding:\n      calc(var(--panel-pad-block-expanded) - 1px)\n      calc(var(--panel-pad-inline-expanded) - 1px) !important;\n  }\n  \/* Figma desktop panel 1:1039: slider is the second row and its endpoint\n     letters sit 4 design units inward from the panel's content edges. *\/\n  dialog.mms-panel .mms-scale { padding-inline: calc(4 * var(--chrome-u)) !important; }\n}\n\n\/* ---------- montran band: map tile (post-neutralizer; NO margin\/padding decls,\n   so the neutralizer's keep-last rule is unaffected) ----------\n   Cargo pins color + font-family on text inside bodycopy (.mms inheritance never\n   reaches it) \u2014 counter with the vars. The sanitizer strips inline font-family,\n   so these MUST live here, not inline.\n   Caption = Cargo native icon + hanging text (\"acts like a bullet\" \u2014 Ocean).\n   Figma Frame 339:784: icon 20.7x19.3, gap 2, text 493 in a 515.7 row;\n   em units (@ caption 14px: 1.48em=20.7, 0.143em=2) keep it scaling with\n   typeface + type-scale axes. *\/\n.mms-tile, .mms-band .caption { font-family: var(--font-family-base); color: var(--color-text-primary); }\n.mms-band .caption { display: flex; align-items: flex-start; gap: 0.2em; }\n.mms-band .caption text-icon {\n  flex: 0 0 auto; width: 1.1em !important; height: 1.1em !important;\n  transform: translateY(0.08em);\n}\n\/* kelly zine caption: icon points UP at the grid (Figma 442:521 rot 90) *\/\n[data-band=\"kelly\"] .caption text-icon { transform: translateY(0.08em) rotate(-90deg); }\n\/* neutralizer-proof paddings for river captions *\/\n[data-slot=\"kelly-caption\"] { padding-top: calc(8*var(--layout-u)) !important; }\n\n\/* ---------- Round 21: captioned tiles + compact showcase refinements ---------- *\/\n.mms-map-tile {\n  --map-gap: calc(12 * var(--layout-u));\n  --map-tile-h: calc(504 * var(--asset-u));\n  --map-image-w: calc(690 * var(--asset-u));\n  --map-image-h: calc(442 * var(--asset-u));\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: flex-end !important;\n  align-items: flex-start;\n  gap: var(--map-gap) !important;\n  height: var(--map-tile-h) !important;\n  overflow: hidden;\n}\n.mms-map-tile > [data-slot=\"montran-map-caption\"] {\n  flex: 0 0 auto;\n  margin: 0 !important;\n}\n.mms-map-tile > .mms-frame {\n  flex: 0 0 auto !important;\n  width: var(--map-image-w) !important;\n  height: var(--map-image-h) !important;\n  aspect-ratio: 690 \/ 442;\n}\n.mms-map-tile > .mms-frame > .mms-img {\n  object-fit: contain;\n  object-position: left bottom;\n}\n\n[data-frame-for=\"randompics-video\"] {\n  width: calc(432 * var(--asset-u));\n  height: calc(667.2 * var(--asset-u));\n  aspect-ratio: 432 \/ 667.2;\n  flex: 0 0 auto;\n}\n\n\/* Kelly is a nested grid rather than a direct river child. Pin its expanded\n   geometry explicitly so Cargo's generic image rules cannot turn the four\n   cells into a single oversized row. *\/\n@media (min-width: 1024px) {\n  [data-band=\"kelly\"] > .mms-river {\n    height: auto !important;\n  }\n  [data-slot=\"kelly-grid\"] {\n    display: grid !important;\n    grid-template-columns: repeat(2, calc(523.4 * var(--layout-u))) !important;\n    grid-template-rows: repeat(2, calc(380.2 * var(--layout-u))) auto !important;\n    width: calc(1046.8 * var(--layout-u)) !important;\n    height: auto !important;\n  }\n  [data-slot=\"kelly-grid\"] > .mms-frame {\n    width: calc(523.4 * var(--layout-u)) !important;\n    height: calc(380.2 * var(--layout-u)) !important;\n    aspect-ratio: 523.4 \/ 380.2;\n  }\n  [data-slot=\"kelly-grid\"] > .mms-frame > .mms-img { object-fit: contain; }\n}\n\n@media (max-width: 1023px) {\n  \/* Four equal-width horizontal cards. The caption occupies only the first\n     column, so its sentence wraps locally instead of spanning the river. *\/\n  [data-slot=\"kelly-grid\"] {\n    display: grid !important;\n    grid-template-columns: repeat(4, var(--mobile-media-w)) !important;\n    grid-template-rows: auto auto !important;\n    column-gap: clamp(16px, 3vw, 24px) !important;\n    row-gap: var(--space-12) !important;\n    width: max-content !important;\n    height: auto !important;\n    background: var(--color-bg-page);\n  }\n  [data-slot=\"kelly-grid\"] > .mms-frame {\n    width: var(--mobile-media-w) !important;\n    height: auto !important;\n    aspect-ratio: 523.4 \/ 380.2;\n    grid-row: 1 !important;\n  }\n  [data-slot=\"kelly-grid\"] > [data-kelly-item=\"3\"] { grid-column: 1 !important; }\n  [data-slot=\"kelly-grid\"] > [data-kelly-item=\"2\"] { grid-column: 2 !important; }\n  [data-slot=\"kelly-grid\"] > [data-kelly-item=\"1\"] { grid-column: 3 !important; }\n  [data-slot=\"kelly-grid\"] > [data-kelly-item=\"4\"] { grid-column: 4 !important; }\n  \/* Cargo appends a later `.mms * { padding: 0 !important; }` clone in some\n     mobile renders. Keep this selector more specific, and reserve enough ink\n     space for the deepest compact Sans XL descender before the river's\n     intentional overflow-y clipping boundary. *\/\n  .mms [data-slot=\"kelly-caption\"] {\n    grid-column: 1 !important;\n    grid-row: 2 !important;\n    width: var(--mobile-media-w) !important;\n    padding-top: 0 !important;\n    padding-bottom: max(6px, 0.25em) !important;\n    box-sizing: border-box;\n  }\n  [data-band=\"kelly\"] .mms-desc { position: relative; }\n  [data-band=\"kelly\"] .mms-desc::before {\n    content: \"\";\n    position: absolute;\n    z-index: 0;\n    top: -1px;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: var(--color-bg-page);\n    pointer-events: none;\n  }\n\n  \/* Compact booklet interaction belongs to the parent river. Transparent\n     tap halves permit a single page command, while touch-action leaves both\n     native horizontal river panning and vertical page scrolling available. *\/\n  .mms-booklet-shell > .mms-booklet { pointer-events: none; }\n  .mms-booklet-gesture {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    display: grid;\n    grid-template-columns: 46% 8% 46%;\n    touch-action: pan-x pan-y;\n  }\n  .mms-booklet-turn {\n    min-width: 0;\n    min-height: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    color: transparent;\n    appearance: none;\n    -webkit-appearance: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: pan-x pan-y;\n  }\n  .mms-booklet-turn[data-booklet-turn=\"previous\"] { grid-column: 1; }\n  .mms-booklet-turn[data-booklet-turn=\"next\"] { grid-column: 3; }\n\n  \/* Caption and media form one opaque, centered unit. This prevents the\n     sticky header from showing through their intentional internal gap. *\/\n  .mms-band[data-band=\"randompics\"] {\n    padding: 0 !important;\n  }\n  [data-band=\"randompics\"] .mms-river {\n    width: 100%;\n    justify-content: center;\n    overflow-x: hidden;\n    padding-inline: var(--margin-page) !important;\n  }\n  [data-band=\"randompics\"] .mms-river::before,\n  [data-band=\"randompics\"] .mms-river::after { display: none; }\n  [data-band=\"randompics\"] .mms-tile {\n    --randompics-video-w: var(--mobile-media-w);\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: center;\n    justify-content: flex-end !important;\n    gap: var(--space-12) !important;\n    width: var(--randompics-video-w) !important;\n    height: auto !important;\n    background: var(--color-bg-page);\n  }\n  [data-slot=\"randompics-caption\"] {\n    width: var(--randompics-video-w) !important;\n  }\n  [data-frame-for=\"randompics-video\"] {\n    flex: 0 0 auto !important;\n    width: var(--randompics-video-w) !important;\n    height: auto !important;\n    aspect-ratio: 432 \/ 667.2;\n  }\n\n  .mms-map-tile {\n    width: var(--mobile-media-w) !important;\n    height: auto !important;\n    gap: var(--space-12) !important;\n    overflow: visible;\n    background: var(--color-bg-page);\n  }\n  .mms-map-tile > [data-slot=\"montran-map-caption\"] {\n    width: var(--mobile-media-w) !important;\n  }\n  .mms-map-tile > .mms-frame {\n    width: var(--mobile-media-w) !important;\n    height: auto !important;\n  }\n  #mms-tw-rig { display: none !important; }\n  [data-band=\"montran\"] iframe[data-src] { background: #000; }\n  [data-slot=\"mandy-hf-alpha-video\"] { background: transparent !important; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .mms-intro [uses=\"rotation\"] { animation: none !important; }\n  html[data-render-preview] body,\n  html[data-render-preview] .mms,\n  html[data-render-preview] .mms-img,\nhtml[data-render-preview] .mms-frame { transition: none !important; }\n}\n\n\/* Cargo's generated mobile-offset sheet can be injected after the managed\n   stylesheet. Keep this final and specific: text navigation follows the body\n   baseline; the actual control surfaces remain 44px. *\/\n.mms .mms-rail a {\n  padding-block: 0 !important;\n  line-height: var(--lh-base) !important;\n}\n@media (max-width: 1023px) {\n  .mms .mms-mbar .mms-mlinks a {\n    display: block !important;\n    min-height: 0 !important;\n    padding-block: 0 !important;\n    line-height: var(--lh-base) !important;\n  }\n}\n\n\/* ---------- Named pages: Who + Write (Figma 502:466 \/ 532:1208) ----------\n   These pages share the current MM.S shell and control runtime, but their\n   content is ordinary editorial layout rather than a showcase river. Keep\n   every rule page-scoped so Work remains unchanged. *\/\n.mms[data-page] .mms-main {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.mms[data-page] .mms-sticky-head { z-index: 1; }\n.mms[data-page] .mms-intro p:first-child { margin-top: 0 !important; }\n.mms[data-page] .mms-person-copy h1,\n.mms[data-page] .mms-writing-piece h1 {\n  margin: 0 !important;\n  padding: 0 !important;\n  font-family: var(--font-family-base);\n  font-size: var(--font-size-base);\n  line-height: var(--lh-base);\n  font-weight: 400;\n  color: var(--color-text-primary);\n}\n\n\/* Who: 664px introduction followed by two 432px founder columns. *\/\n.mms[data-page=\"who\"] .mms-sticky-head {\n  position: relative;\n  top: auto;\n  height: auto;\n}\n@media (min-width: 1024px) {\n  .mms[data-page=\"who\"] .mms-main {\n    display: flex;\n    flex-direction: column;\n  }\n}\n.mms[data-page=\"who\"] .mms-who-intro-compact { display: none; }\n.mms[data-page=\"who\"] .mms-who-ocean-stage { display: contents; }\n.mms[data-page=\"who\"] .mms-who-profiles {\n  display: grid;\n  grid-template-columns: var(--col-4) var(--col-4);\n  gap: var(--space-32);\n  width: var(--col-10);\n  margin-top: auto !important;\n}\n.mms[data-page=\"who\"] .mms-person {\n  width: var(--col-4);\n  min-width: 0;\n}\n.mms[data-page=\"who\"] .mms-person-media {\n  display: flex;\n  width: 100%;\n  height: auto;\n}\n.mms[data-page=\"who\"] .mms-person-media .mms-frame {\n  width: max(200px, calc(200 * var(--layout-u)));\n  height: auto;\n  aspect-ratio: 200 \/ 237.276;\n  flex: 0 0 auto;\n}\n.mms[data-page=\"who\"] .mms-person-copy {\n  width: 100%;\n  padding-top: var(--space-16) !important;\n}\n.mms[data-page=\"who\"] .mms-person-copy p {\n  margin-top: var(--space-8) !important;\n  font-size: var(--font-size-caption);\n  line-height: var(--lh-caption);\n}\n.mms[data-page=\"who\"] .mms-person-copy a {\n  display: inline-block;\n  margin-top: var(--space-8) !important;\n}\n\n\/* Write: Figma's five editorial blocks use deliberate staggered widths. *\/\n.mms[data-page=\"write\"] .mms-writing {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-64);\n  width: var(--col-10);\n}\n.mms[data-page=\"write\"] .mms-write-top {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-32);\n  min-height: calc(304 * var(--layout-u));\n  margin-left: max(\n    0px,\n    calc((100% - max(316px, calc(316 * var(--layout-u))) - max(316px, calc(316 * var(--layout-u))) - var(--space-32)) \/ 2)\n  ) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-piece {\n  box-sizing: border-box;\n  min-width: 0;\n  padding-top: 0 !important;\n  background: var(--color-bg-page);\n  font-size: var(--font-size-base);\n  line-height: var(--lh-base);\n}\n.mms[data-page=\"write\"] .mms-writing-plate { display: contents; }\n.mms[data-page=\"write\"] .mms-writing-plate > p,\n.mms[data-page=\"write\"] .mms-writing-plate > ol,\n.mms[data-page=\"write\"] .mms-writing-plate > ul {\n  margin-top: var(--space-8) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-withered .mms-writing-plate > p + p {\n  margin-top: var(--lh-base) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-piece ol,\n.mms[data-page=\"write\"] .mms-writing-piece ul {\n  padding-left: calc(27 * var(--layout-u)) !important;\n}\n.mms[data-page=\"write\"] .mms-list-continuation {\n  display: inline-block;\n  padding-left: calc(9 * var(--layout-u)) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-selfhelp,\n.mms[data-page=\"write\"] .mms-writing-clout { width: max(316px, calc(316 * var(--layout-u))); }\n.mms[data-page=\"write\"] .mms-writing-selfhelp { min-height: calc(247 * var(--layout-u)); }\n.mms[data-page=\"write\"] .mms-writing-clout { min-height: calc(201 * var(--layout-u)); }\n.mms[data-page=\"write\"] .mms-writing-withered {\n  width: max(432px, var(--col-4));\n  min-height: calc(458 * var(--layout-u));\n  margin-top: 0 !important;\n  margin-left: min(\n    calc((2 * var(--col-2)) + (2 * var(--space-32))),\n    max(0px, calc(100% - max(432px, var(--col-4))))\n  ) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-amazon {\n  width: max(664px, var(--col-6));\n  min-height: calc(254 * var(--layout-u));\n  margin-top: 0 !important;\n  margin-left: max(0px, calc((100% - max(664px, var(--col-6))) \/ 2)) !important;\n}\n.mms[data-page=\"write\"] .mms-writing-world {\n  width: max(432px, var(--col-4));\n  min-height: calc(204 * var(--layout-u));\n  margin-top: 0 !important;\n  margin-left: auto !important;\n}\n\n@media (max-width: 1023px) {\n  \/* Named pages inherit the exact Home sticky-link contract. The shared\n     ResizeObserver therefore produces the same MM.S-to-links gap and bar\n     height on Work, Who, and Write. *\/\n  .mms[data-page] .mms-main {\n    min-height: 0;\n    padding: 0 0 var(--space-64) !important;\n  }\n  .mms[data-page] {\n    \/* Full containers follow the six-column grid. The deliberately irregular\n       editorial blocks below retain their 390px Figma proportions, then cap\n       at the corresponding desktop text-frame endpoints. *\/\n    --named-grid-width: var(--compact-grid-span-6);\n    --write-selfhelp-width: 100%;\n    --write-clout-width: var(--compact-grid-span-4);\n    --write-withered-width: 100%;\n    --write-amazon-width: 100%;\n    --write-world-width: 100%;\n  }\n\n  .mms[data-page=\"who\"] .mms-who-intro-expanded { display: none; }\n  .mms[data-page=\"who\"] .mms-who-ocean-stage {\n    display: block;\n    position: relative;\n    overflow: visible;\n  }\n  .mms[data-page=\"who\"] .mms-who-intro-compact {\n    display: block;\n    position: sticky;\n    top: var(--bar-h, 200px);\n    height: auto;\n    z-index: 1;\n    background: transparent;\n    padding: var(--space-24) 0 var(--space-24) !important;\n  }\n  .mms[data-page=\"who\"] .mms-who-profiles {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap: var(--space-32);\n    width: var(--named-grid-width);\n    margin: 0 0 0 var(--margin-page) !important;\n  }\n  .mms[data-page=\"who\"] .mms-person {\n    position: relative;\n    z-index: 20;\n    width: 100%;\n    background: transparent;\n  }\n  .mms[data-page=\"who\"] .mms-person-ocean {\n    padding-top: var(--space-40) !important;\n  }\n  .mms[data-page=\"who\"] .mms-person-media {\n    position: relative;\n    background: var(--color-bg-page);\n    width: 100%;\n    height: auto;\n  }\n  .mms[data-page=\"who\"] .mms-person-media .mms-frame {\n    width: min(200px, calc(var(--named-grid-width) - var(--compact-grid-span-4)));\n    height: auto;\n    aspect-ratio: 200 \/ 237.276;\n  }\n  .mms[data-page=\"who\"] .mms-person-copy {\n    position: relative;\n    background: var(--color-bg-page);\n    padding-top: var(--space-16) !important;\n  }\n\n  .mms[data-page=\"write\"] .mms-sticky-head { display: none; }\n  .mms[data-page=\"write\"] .mms-writing {\n    display: flex;\n    flex-direction: column;\n    gap: var(--space-32);\n    position: relative;\n    z-index: auto;\n    width: var(--named-grid-width);\n    margin: var(--space-32) 0 0 var(--margin-page) !important;\n    background: transparent;\n    pointer-events: none;\n  }\n  .mms[data-page=\"write\"] .mms-write-top {\n    display: flex;\n    flex-direction: column;\n    gap: var(--space-32);\n    min-height: 0;\n    margin-left: 0 !important;\n  }\n  .mms[data-page=\"write\"] .mms-writing-piece {\n    position: relative;\n    z-index: 20;\n    min-height: 0;\n    margin-top: 0 !important;\n    margin-left: 0 !important;\n    padding-top: 0 !important;\n    background: transparent;\n    pointer-events: none;\n  }\n  .mms[data-page=\"write\"] .mms-writing-plate {\n    display: inline-block;\n    box-sizing: border-box;\n    width: fit-content;\n    max-width: 100%;\n    padding-top: 0 !important;\n    background: var(--color-bg-page);\n    pointer-events: auto;\n  }\n  .mms[data-page=\"write\"] .mms-writing-piece ol,\n  .mms[data-page=\"write\"] .mms-writing-piece ul { padding-left: 18px !important; }\n  .mms[data-page=\"write\"] .mms-writing-plate > h1 + p,\n  .mms[data-page=\"write\"] .mms-writing-plate > h1 + ol,\n  .mms[data-page=\"write\"] .mms-writing-plate > h1 + ul {\n    margin-top: var(--space-16) !important;\n  }\n  .mms[data-page=\"write\"] .mms-list-continuation { padding-left: 9px !important; }\n  .mms[data-page=\"write\"] .mms-writing-selfhelp { width: var(--write-selfhelp-width); }\n  .mms[data-page=\"write\"] .mms-writing-clout {\n    width: var(--write-clout-width);\n    align-self: flex-end;\n  }\n  .mms[data-page=\"write\"] .mms-writing-withered { width: var(--write-withered-width); }\n  .mms[data-page=\"write\"] .mms-writing-amazon { width: var(--write-amazon-width); }\n  .mms[data-page=\"write\"] .mms-writing-world {\n    width: var(--write-world-width);\n    align-self: flex-start;\n  }\n}\n\n\/* Named-page additions live after Cargo's generated mobile-offset clones.\n   Reassert only the non-zero compact spacing introduced by this section. *\/\n@media (max-width: 1023px) {\n  .mms[data-page] .mms-intro-wrap > .mms-mlinks {\n    padding: var(--space-24) var(--margin-page) var(--space-16) !important;\n    margin-top: 0 !important;\n  }\n  .mms[data-page=\"who\"] .mms-who-intro-compact {\n    padding: var(--space-24) 0 var(--space-24) !important;\n  }\n  .mms[data-page=\"who\"] .mms-person-ocean {\n    padding-top: var(--space-40) !important;\n  }\n  .mms[data-page=\"who\"] .mms-who-profiles {\n    margin: 0 0 0 var(--margin-page) !important;\n  }\n}","created_at":"2022-09-15T23:40:11.000000Z","updated_at":"2026-07-20T14:37:27.000000Z"}